{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "language",
    "scope",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "language": {
      "const": "en"
    },
    "scope": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic",
          "phrase",
          "positive",
          "negative"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "phrase": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "contextAny": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "positive": {
            "type": "string"
          },
          "negative": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            }
          }
        }
      }
    }
  }
}