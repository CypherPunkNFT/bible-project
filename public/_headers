/testimonies*
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
/data/*
  Cache-Control: public, max-age=3600
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/content/teacher-library/pages/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/content/teacher-library/records/*
  Cache-Control: no-cache
/content/teacher-library/contributors/*
  Cache-Control: no-cache
/content/teacher-library/catalogue.json
  Cache-Control: no-cache
/content/reading-sources.json
  Cache-Control: no-cache
/atlas-tiles/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
/atlas-tiles/bible-atlas.json
  ! Cache-Control
  Cache-Control: public, max-age=300
/search-model/*
  Cache-Control: public, max-age=31536000, immutable
/search-model/meaning.json
  ! Cache-Control
  Cache-Control: public, max-age=300
