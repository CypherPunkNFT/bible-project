/testimonies*
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
# Every data address carries the release's content stamp (scripts/pack-reader-data.mjs), so a change gives new
# addresses; only the two indexes that carry the stamp are checked on every visit.
/data/*
  Cache-Control: public, max-age=31536000, immutable
/data/catalog.json
  ! Cache-Control
  Cache-Control: no-cache
/data/study/index.json
  ! Cache-Control
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/content/teacher-library/pages/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/content/teacher-library/records/*
  Cache-Control: no-cache
/content/teacher-library/contributors/*
  Cache-Control: no-cache
/content/teacher-library/catalogue.json
  Cache-Control: no-cache
/content/reading-sources.json
  Cache-Control: no-cache
/atlas-tiles/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
/atlas-tiles/bible-atlas.json
  ! Cache-Control
  Cache-Control: public, max-age=300
/search-model/*
  Cache-Control: public, max-age=31536000, immutable
/search-model/meaning.json
  ! Cache-Control
  Cache-Control: public, max-age=300
# The Cloudflare preview addresses are copies of the site: only bibleguide.io may appear in search results.
https://bible-project-4af.pages.dev/*
  X-Robots-Tag: noindex
https://:alias.bible-project-4af.pages.dev/*
  X-Robots-Tag: noindex
https://bible-project.cypherpunknft.workers.dev/*
  X-Robots-Tag: noindex
# A sympathy card link is a personal page sent to someone grieving: never in search results (docs/features/sympathy/design.md 5.5).
/sympathy/card/*
  X-Robots-Tag: noindex
# The verse-of-the-day widget (docs/features/verse-widget/design.md 6.3): read by other websites, so open to all
# origins, cached a day, and never sending a cookie or a referrer.
/widget/v1/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
/widget/v1/frame
  ! Cache-Control
  Cache-Control: public, max-age=3600
  Content-Security-Policy: default-src 'none'; script-src 'self' https://bibleguide.io; connect-src 'self' https://bibleguide.io; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'
  X-Robots-Tag: noindex
