  "leftOut": [
    { "name": "Cyprus (Paul's first journey)", "reason": "The island as a whole (Acts 13:4); its stops, Salamis and Paphos, are cards instead." },
    { "name": "Pisidia and Pamphylia (Paul's first journey)", "reason": "Regions passed through on the way back (Acts 14:24), not single places." },
    { "name": "Syria and Cilicia (Paul's second journey)", "reason": "A region summary (Acts 15:41)." },
    { "name": "Phrygia and Galatia (Paul's second journey)", "reason": "A region summary (Acts 16:6)." },
    { "name": "Mysia (Paul's second journey)", "reason": "They passed by it (Acts 16:8)." },
    { "name": "Iconium (Paul's second journey)", "reason": "Acts 16:2 says only that the brothers there spoke well of Timothy; no verse says Paul came there on this journey." },
    { "name": "Cenchrea (Paul's second journey)", "reason": "Named only for the head-shaving before Paul sailed (Acts 18:18); no verse tells an arrival, and it is a departure point." },
    { "name": "Jerusalem (Paul's second journey)", "reason": "Acts 18:22 in the Greek says only that Paul 'went up and greeted the church'; the city is supplied by the translation, so the stop is not certain." },
    { "name": "Galatia and Phrygia (Paul's third journey)", "reason": "A region summary (Acts 18:23)." },
    { "name": "Macedonia and Greece (Paul's third journey)", "reason": "Regions, and their first arrival on this journey is disputed: Paul's letters put Troas before Macedonia (2 Corinthians 2:12-13) and a visit to Corinth from Ephesus probably came before Acts 20:1-2." },
    { "name": "Philippi (Paul's third journey)", "reason": "Named only as the port Paul sailed from (Acts 20:6); when he first reached it in Macedonia is not told, and Troas may have come first (2 Corinthians 2:12-13)." },
    { "name": "Chios (Paul's third journey)", "reason": "The ship only arrived 'opposite Chios' (Acts 20:15); it did not put in." },
    { "name": "Cyprus (Paul's third journey)", "reason": "Only sighted and passed (Acts 21:3)." },
    { "name": "Cyprus (Paul's voyage to Rome)", "reason": "The ship only sailed to the lee of it (Acts 27:4)." },
    { "name": "Cnidus (Paul's voyage to Rome)", "reason": "The ship only 'arrived off Cnidus' and the wind kept it from putting in (Acts 27:7)." },
    { "name": "Crete and Salmone (Paul's voyage to Rome)", "reason": "Sailed along, to the lee of Crete and opposite Salmone (Acts 27:7); Fair Havens is the stop there." },
    { "name": "Phoenix (Paul's voyage to Rome)", "reason": "The harbour they hoped to reach and never did (Acts 27:12)." },
    { "name": "Cauda (Paul's voyage to Rome)", "reason": "The ship only passed it (Acts 27:16, 'passing to the lee')." },
    { "name": "Kadesh (Israel in the wilderness)", "reason": "Israel is at Kadesh early (the spies, Numbers 13:26) and again late (Numbers 20:1; 33:36), and Numbers 33 lists only the late stop." },
    { "name": "Moseroth and Bene-jaakan (Israel in the wilderness)", "reason": "Deuteronomy 10:6 and Numbers 33:30-31 give them in opposite orders." },
    { "name": "Taberah (Israel in the wilderness)", "reason": "Named in the story (Numbers 11:3) but not in the Numbers 33 itinerary, so whether it is a separate stop before Kibroth-hattaavah is not certain." },
    { "name": "The Desert of Shur and the Wilderness of Paran (Israel in the wilderness)", "reason": "Wide regions rather than camps; Israel was in Paran at more than one time (Numbers 10:12; 12:16; 13:26)." },
    { "name": "The Red Sea camp (Israel in the wilderness)", "reason": "Numbers 33:10 has Israel camp by the Red Sea after Elim, which a player would confuse with the crossing at Pi-hahiroth." },
    { "name": "Stops after Iye-abarim (Israel in the wilderness)", "reason": "Numbers 21:12-20 (Zered, the Arnon, Beer, Mattanah, Nahaliel, Bamoth) and Numbers 33:45-47 (Dibon-gad, Almon-diblathaim, the mountains of Abarim) name different places, so how they interleave is not certain." },
    { "name": "Other camps known only from Numbers 33 (Israel in the wilderness)", "reason": "Dophkah, Alush, Rithmah to Abronah, Zalmonah and Punon are very obscure names from the list alone; Jotbathah also appears in Deuteronomy 10:7 on a route that may be a different trip. Left out to keep the journey certain and playable." },
    { "name": "The Negev and the land of Canaan (Abraham)", "reason": "Regions (Genesis 12:5, 12:9; 13:1; 20:1)." },
    { "name": "Dan and Hobah (Abraham)", "reason": "A pursuit to rescue Lot (Genesis 14:14-15), not a place Abraham went to live or camp; 'Dan' is also the later name of the town." },
    { "name": "The hill country of Gilead, Galeed and Mizpah (Jacob)", "reason": "Gilead is a region (Genesis 31:25), and the heap there has two names, Galeed and Mizpah (31:47-49), which would make a confusing card." },
    { "name": "The ford of the Jabbok (Jacob)", "reason": "A river crossing on the way to Peniel (Genesis 32:22); Peniel is the stop there." },
    { "name": "The Tower of Eder (Jacob)", "reason": "Jacob pitched his tent beyond it (Genesis 35:21), not at it." },
    { "name": "Goshen (Jacob)", "reason": "Part of Egypt (Genesis 46:28); Egypt is the stop." },
    { "name": "Abel-meholah (Elijah)", "reason": "It is Elisha's home (1 Kings 19:16), but 19:19 does not say where Elijah found him, so no verse places Elijah there." },
    { "name": "Samaria (Elijah)", "reason": "1 Kings 18:2 says the famine was severe in Samaria; it does not place Elijah there." },
    { "name": "The Desert of Damascus (Elijah)", "reason": "Only commanded (1 Kings 19:15); no verse tells Elijah going there." },
    { "name": "Baale of Judah, the house of Abinadab (the ark of the covenant)", "reason": "The same place as Kiriath-jearim (1 Samuel 7:1; 2 Samuel 6:2-3), not a new stop." },
    { "name": "The towns between Azotus and Caesarea (Philip)", "reason": "An unnamed summary (Acts 8:40)." },
    { "name": "Jonathan's meeting place (David fleeing Saul)", "reason": "1 Samuel 20 names no town for where David met Jonathan." },
    { "name": "The stronghold (David fleeing Saul)", "reason": "Not named (1 Samuel 22:4-5); it is unclear whether it is Adullam or a place in Moab." },
    { "name": "Horesh and the hill of Hachilah (David fleeing Saul)", "reason": "Spots inside the Wilderness of Ziph (1 Samuel 23:15, 19; 26:1-3), which is the stop." },
    { "name": "The Wilderness of Paran (David fleeing Saul)", "reason": "1 Samuel 25:1 reads Paran in the Hebrew but Maon in the Greek, so the stop is not certain." },
    { "name": "Carmel (David fleeing Saul)", "reason": "Nabal's town (1 Samuel 25:2); no verse places David in it." }
