{"book":"MIC","headings":[{"span":[33001001,33001001],"quote":"The word of the LORD that came to Micah the Morasthite in the days of Jotham, Ahaz, and Hezekiah, kings of Judah, which he saw concerning Samaria and Jerusalem.","rulers":["jotham-2ki-15-5","ahaz-2ki-15-38","hezekiah-2ki-16-20"],"prophet":"micah-jer-26-18"}],"related":[{"span":[24026018,24026018],"quote":"Micah the Morasthite prophesied in the days of Hezekiah king of Judah, and spake to all the people of Judah, saying, Thus saith the LORD of hosts; Zion shall be plowed like a field, and Jerusalem shall become heaps, and the mountain of the house as the high places of a forest.","rulers":["hezekiah-2ki-16-20"],"note":"Jeremiah 26:18 says Micah the Morasthite prophesied in Hezekiah’s days, agreeing with Micah 1:1."}],"chapters":{"1":{"rulers":[{"id":"jotham-2ki-15-5","named":[1]},{"id":"ahaz-2ki-15-38","named":[1]},{"id":"hezekiah-2ki-16-20","named":[1]}],"prophets":[{"id":"micah-jer-26-18","named":[1]}]},"6":{"rulers":[{"id":"moses-exo-2-10","named":[4]},{"id":"omri-1ki-16-16","named":[16]},{"id":"ahab-1ki-16-28","named":[16]}],"prophets":[{"id":"aaron-exo-4-14","named":[4]},{"id":"miriam-exo-15-20","named":[4]},{"id":"balaam-num-22-5","named":[5]}]}},"rulers":{"ahab-1ki-16-28":{"name":"Ahab","title":"King of Israel","kind":"king","realm":"israel","sex":"M","dates":{"from":874,"to":853,"label":"Thiele, as revised by McFall and Young","approx":true},"prophets":6},"ahaz-2ki-15-38":{"name":"Ahaz","title":"King of Judah","kind":"king","realm":"judah","sex":"M","dates":{"from":735,"to":715,"label":"Thiele, revised by McFall (1991)","approx":true},"prophets":4},"hezekiah-2ki-16-20":{"name":"Hezekiah","title":"King of Judah","kind":"king","realm":"judah","sex":"M","dates":{"from":729,"to":687,"label":"Thiele, revised by McFall (1991)","approx":true},"prophets":3},"jotham-2ki-15-5":{"name":"Jotham","title":"King of Judah","kind":"king","realm":"judah","sex":"M","dates":{"from":750,"to":732,"label":"Thiele, revis