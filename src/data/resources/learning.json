      "outline": {
        "parts": [
          {
            "part": 1,
            "label": "The first forty",
            "place": "Egypt",
            "ref": "Acts 7:20–29"
          },
          {
            "part": 2,
            "label": "The second forty",
            "place": "Midian",
            "ref": "Acts 7:29–35"
          },
          {
            "part": 3,
            "label": "The third forty",
            "place": "The wilderness",
