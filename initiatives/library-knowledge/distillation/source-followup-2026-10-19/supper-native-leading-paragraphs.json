      "start": 136732,
      "end": 188973,
      "span_sha256": "aedf964c55e9f8ef332e2ad9cccc58fc1c893b7c0c84b46e788ab18849c3b9aa",
      "questions": [
        {
          "number": 1,
          "question": "1 . In what passages of the New Testament is the institution of the Lord’s Supper recorded ?",
          "start": 136763,
          "heading_end": 136856,
          "end": 136944,
          "span_sha256": "1afc891e3de8a753a0a2bc10adf2a05da3e7141408434c2d8060707278361c27"
        },
        {
          "number": 2,
          "question": "2. Prove that its observance is a perpetual obligation.",
          "start": 136944,
          "heading_end": 137000,
          "end": 137544,
          "span_sha256": "38b12f5c1d448aa839b58506f2a994eb83b1cf53eb979c8f0bff61d40133323f"
        },
        {
          "number": 3,
          "question": "3 . What are the various phrases used in Scripture to designate the Lord’s Supper, and their import ?",
          "start": 137544,
          "heading_end": 137647,
          "end": 138791,
          "span_sha256": "eb3a95f8a4c3a723b7f51f75922e66c060c4a90af666a69065a908fd0ae6292c"
        },
        {
          "number": 4,
          "question": "4 . By what other terms was it designated in the early church ?",
          "start": 138791,
          "heading_end": 138855,
          "end": 140713,
          "span_sha256": "1cf3a3ea424f3ff56093751ad71a18029cd8f79e3e197ba2e395380094431aae"
        },
        {
          "number": 5,
          "question": "5 . How is this sacrament defined, and what are the essential points included in the definition ?",
          "start": 140713,
          "heading_end": 140812,
          "end": 141451,
          "span_sha256": "c945a4eb3951529227fff466c16c5ae58e195d2ddc622c37501f3b8213fa68c8"
        },
        {
          "number": 6,
          "question": "6 . What kind of bread is to be used in the sacrament, and what is the usage of the different churches on this point ?",
          "start": 141451,
          "heading_end": 141571,
          "end": 142860,
          "span_sha256": "0d7e16eb1c64d78e6b316878861ad770d34e88437b06323e8f6be9f6b19da9de"
        },
        {
          "number": 7,
          "question": "7. What is the meaning of the term ὀῖνος, wine , in the New Testament, and how does it appear that wine and no other liquid must be used in the Lord’s Supper ?",
          "start": 142860,
          "heading_end": 143020,
          "end": 144281,
          "span_sha256": "035a0cd6d2144ba544e64af90201fdf30812c3040bbb11ed6145232122beb9fe"
        },
        {
          "number": 8,
          "question": "8 . How does it appear that breaking the bread is an important part of the service ?",
          "start": 144281,
          "heading_end": 144366,
          "end": 145144,
          "span_sha256": "29e8e7158a452fe38001454663ce74836c8b94a958b4af2679c17a58aea88c00"
        },
        {
          "number": 9,
          "question": "9. What is the proper interpretation of 1 Corinthians 10:16, and in what sense are the elements to be blessed or consecrated ?",
          "start": 145144,
          "heading_end": 145272,
          "end": 146637,
          "span_sha256": "18dde08fff5ce8fd87b2e4448f997fb1aae86ab5de2b91177d3fc3d63ceea56f"
        },
        {
          "number": 10,
          "question": "10 . Show that the distribution of the elements to the people and their reception by them is an essential part of this sacrament ?",
          "start": 146637,
          "heading_end": 146769,
          "end": 149162,
          "span_sha256": "744f469a77037f9b2fb0be1cf3818dda33c1c5ef0708235b81474fc8ee08b643"
        },
        {
          "number": 11,
          "question": "11. What should be the nature of the exercises during the distribution of the elements ?",
          "start": 149162,
          "heading_end": 149251,
          "end": 150395,
          "span_sha256": "98425dc2259f3db717a33131cb2c6625a690aeaf566fd020923f4d222dd4f935"
        },
        {
          "number": 12,
          "question": "12. What is the Romish doctrine on this subject? And how is it expressed by the term",
          "start": 150395,
          "heading_end": 150480,
          "end": 152580,
          "span_sha256": "0e9b883e0ed2b4d2f209e99af097e4e0d47686629ef0bb0d0383378f09d31902"
        },
        {
          "number": 13,
          "question": "13 . On what grounds does the Romish Church withhold the use of the cup from all except the officiating priest and what is their doctrine of ‘concomitance.’ (bread and wine ‘are one’ with the body and blood of Christ)?",
          "start": 152580,
          "heading_end": 152801,
          "end": 154063,
          "span_sha256": "cc421cfaaf2352be81787eb95b10bc5a91ac0dcb642a76b605a3b796162e2117"
        },
        {
          "number": 14,
          "question": "14 . Present the arguments proving the Romish doctrine of the relation of the sign to the things signified to be unscriptural as well as irrational.",
          "start": 154063,
          "heading_end": 154213,
          "end": 157540,
          "span_sha256": "40d8f30a9d8d7aece64890f77f2158bfc43a4fb6b38c38caf45bbf57b266a85f"
        },
        {
          "number": 15,
          "question": "15. State the Lutheran view as to the nature of Christ’s presence in the Eucharist.",
          "start": 157540,
          "heading_end": 157624,
          "end": 158952,
          "span_sha256": "2b3d19895be3f68039cf246c79c6c1beb5826e2916c47741dca22da74c65a2ad"
        },
        {
          "number": 16,
          "question": "16. State the doctrine of the Reformed Church.",
          "start": 158952,
          "heading_end": 158999,
          "end": 162647,
          "span_sha256": "3a019e1a371ab7f028eedc347de5363514811bb7797a0e6dacab4d406539bace"
        },
        {
          "number": 17,
          "question": "17. What is the Romish doctrine as to the efficacy of the Eucharist, and in what sense and on what ground do they hold that it is also a sacrifice ?",
          "start": 162647,
          "heading_end": 162797,
          "end": 164718,
          "span_sha256": "8a70c9591335180a6f4260307d25ae21f74dd482d6e91e0f0c29510cc58e8b63"
        },
        {
          "number": 18,
          "question": "18 . How may this doctrine be refuted ?",
          "start": 164718,
          "heading_end": 164758,
          "end": 166111,
          "span_sha256": "ba22d9212ca5941067e7951408ff8b961d6bc03fe78a9dfca2e2fcb9c39a16b2"
        },
        {
          "number": 19,
          "question": "19. What is the Lutheran view as to the efficacy of the sacrament ?",
          "start": 166111,
          "heading_end": 166179,
          "end": 166906,
          "span_sha256": "cbd6713f97899f5cadeaff2e993beb5c7520dc509d43e881a4d1c0649eae7944"
        },
        {
          "number": 20,
          "question": "20. What is the so–called Zwinglian and Remonstrant and Socinians view as to the efficacy of the Eucharist?",
          "start": 166906,
          "heading_end": 167015,
          "end": 167607,
          "span_sha256": "3524f2df6c8ee79c7b6d031115ce5fac4e2b6aec096cb978694f2d5522ca76c7"
        },
        {
          "number": 21,
          "question": "21. What is the view of the Reformed churches upon this subject ?",
          "start": 167607,
          "heading_end": 167673,
          "end": 169333,
          "span_sha256": "7d471d57619ecb972dd490885d811044d1b1225eb1a2f2071234cf2ccd300ae8"
        },
        {
          "number": 22,
          "question": "22 . What do our standards teach as to the qualifications for admission to the Lord’s Supper ?",
          "start": 169333,
          "heading_end": 169428,
          "end": 170693,
          "span_sha256": "3f5c4e9cb4d2248d79e4544b993ee0635a78893064badad94b7f28f674ae1166"
        },
        {
          "number": 23,
          "question": "23 . What is the practice which prevails in the different churches on this subject, and on what principles does such practice rest?",
          "start": 170693,
          "heading_end": 170826,
          "end": 172840,
          "span_sha256": "0bdcdc6a29a41d4e3210d7580ad7a713dfb631b741b478b9e2c1544e45f7b4d2"
        },
        {
          "number": 24,
          "question": "24. How may it be proved that the Lord’s Supper is not designed for the unrenewed ?",
          "start": 172840,
          "heading_end": 172924,
          "end": 173635,
          "span_sha256": "6c162fd5174cabc24e25827866b82f01f839a515c48175716328d1de5ee6ec51"
        },
        {
          "number": 25,
          "question": "25. What have the church and its officers a right to require of those whom they admit to the Lord’s Supper ?",
          "start": 173635,
          "heading_end": 173744,
          "end": 174801,
          "span_sha256": "f3e7e807fce4720c1ed65d2ddd96afde22b730b762b005f4bc296249b14727a1"
        },
        {
          "number": 26,
          "question": "26. What is the difference between the Presbyterian and the Congregational churches upon this point?",
          "start": 174801,
          "heading_end": 174902,
          "end": 188973,
          "span_sha256": "867d9964f603ff9a73c3fec67b87dbefccf82fd9ada59e390ae7f554ae2ef02f"
        }
      ]
    },
