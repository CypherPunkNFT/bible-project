{
  "type": "object",
  "additionalProperties": false,
  "required": ["scenes"],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "kind", "verse_start", "verse_end", "moment", "why", "shot", "viewpoint", "focal_point",
                     "foreground", "midground", "background", "people", "light", "mood", "from_text", "added", "avoid",
                     "prompt"],
        "properties": {
          "title": {"type": "string"},
          "kind": {"type": "string", "enum": ["event", "imagery", "vision", "setting"]},
          "verse_start": {"type": "integer", "minimum": 1},
          "verse_end": {"type": "integer", "minimum": 1},
          "moment": {"type": "string"},
          "why": {"type": "string"},
          "shot": {"type": "string", "enum": ["wide", "medium", "close"]},
          "viewpoint": {"type": "string"},
          "focal_point": {"type": "string"},
          "foreground": {"type": "string"},
          "midground": {"type": "string"},
          "background": {"type": "string"},
          "people": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["who", "count", "action"],
              "properties": {
                "who": {"type": "string"},
                "count": {"type": "integer", "minimum": 0},
                "action": {"type": "string"}
              }
            }
          },
          "light": {"type": "string"},
          "mood": {"type": "string"},
          "from_text": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["detail", "verse"],
              "properties": {
                "detail": {"type": "string"},
                "verse": {"type": "integer", "minimum": 1}
              }
            }
          },
          "added": {"type": "array", "items": {"type": "string"}},
          "avoid": {"type": "array", "items": {"type": "string"}},
          "prompt": {"type": "string"}
        }
      }
    }
  }
}
