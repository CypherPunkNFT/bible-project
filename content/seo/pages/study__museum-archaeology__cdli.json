 "title": "CDLI · Museum-Grade Archaeology · Bible Guide",
 "heading": "CDLI",
 "paragraph": "The Cuneiform Digital Library Initiative keeps the standard catalogue of cuneiform tablets wherever they are held. Its own pages ask not to be harvested, so only its published bulk dump was used, verified against the checksum it publishes with it. Credit and share-alike are required.",
 "blocks": [
  {
   "tag": "p",
   "text": "AN OPEN COLLECTION THESE RECORDS CAME FROM"
  },
  {
   "tag": "h1",
   "text": "CDLI"
  },
  {
   "tag": "p",
   "text": "an international project"
  },
  {
   "tag": "p",
   "text": "The Cuneiform Digital Library Initiative keeps the standard catalogue of cuneiform tablets wherever they are held. Its own pages ask not to be harvested, so only its published bulk dump was used, verified against the checksum it publishes with it. Credit and share-alike are required."
  },
  {
   "tag": "p",
   "text": "11,145"
  },
  {
   "tag": "p",
   "text": "records held"
  },
  {
   "tag": "p",
   "text": "120"
  },
  {
   "tag": "p",
   "text": "listed on this page"
  },
  {
   "tag": "p",
   "text": "openly licensed photographs"
  },
  {
   "tag": "p",
   "text": "matched to our catalogue"
  },
  {
   "tag": "p",
   "text": "11,145 records are held for this collection and 120 are listed here — the ones its own records tie to something biblical, audited first. The rest are in the research corpus, not on this page."
