  },
  {
   "tag": "p",
   "text": "In the days of Jehoiachin — Ezekiel 1:2"
  },
  {
   "tag": "p",
   "text": "Read Ezekiel"
  },
  {
   "tag": "p",
   "text": "PROPHET · WROTE A BOOK"
  },
