  {
   "tag": "p",
   "text": "In the days of Jehoiakim — Daniel 1:1"
  },
  {
   "tag": "p",
   "text": "Read Daniel"
  },
  {
   "tag": "p",
   "text": "PROPHET · WROTE A BOOK"
