   "text": "साइप्रस का एक लेवी, जो पौलुस की मिशन यात्राओं में उसके साथ गया।"
  },
  {
   "tag": "p",
   "text": "के दिनों में क्लौदियुस — प्रेरितों के काम 13:1"
  },
  {
   "tag": "p",
   "text": "नबी"
  },
  {
   "tag": "h3",
   "text": "शमौन"
  },
  {
   "tag": "p",
   "text": "अंताकिया की कलीसिया में भविष्यवक्ता और शिक्षक।"
  },
  {
   "tag": "p",
   "text": "के दिनों में क्लौदियुस — प्रेरितों के काम 13:1"
  },
  {
   "tag": "p",
   "text": "नबी"
  },
  {
   "tag": "h3",
   "text": "लूकियुस"
  },
  {
   "tag": "p",
   "text": "अंताकिया की कलीसिया में भविष्यवक्ता और शिक्षक।"
  },
  {
   "tag": "p",
   "text": "के दिनों में क्लौदियुस — प्रेरितों के काम 13:1"
  },
  {
   "tag": "p",
   "text": "नबी"
  },
  {
   "tag": "h3",
   "text": "मनहेम"
  },
  {
   "tag": "p",
   "text": "अंताकिया की कलीसिया में भविष्यवक्ता और शिक्षक।"
  },
  {
   "tag": "p",
   "text": "के दिनों में क्लौदियुस — प्रेरितों के काम 13:1"
  },
  {
   "tag": "p",
   "text": "नबी"
  },
  {
   "tag": "h3",
   "text": "पौलुस"
  },
  {
   "tag": "p",
   "text": "अन्यजातियों का प्रेरित, नए नियम की कई पत्रियों का लेखक"
  },
  {
   "tag": "p",
   "text": "के दिनों में क्लौदियुस — प्रेरितों के काम 13:1"
  },
  {
   "tag": "p",
   "text": "झूठा भविष्यवक्ता"
  },
  {
   "tag": "h3",
   "text": "बर-यीशु"
  },
  {
   "tag": "p",
   "text": "एक यहूदी जादूगर जिसने पौलुस और बरनबास का विरोध किया।"
  },
  {
   "tag": "p",
   "text": "के दिनों में क्लौदियुस — प्रेरितों के काम 13:6"
  },
  {
   "tag": "p",
   "text": "नबी"
  },
  {
   "tag": "h3",
   "text": "यहूदा"
  },
  {
   "tag": "p",
   "text": "एक भविष्यवक्ता और यरूशलेम कलीसिया का अगुवा"
  },
  {
   "tag": "p",
   "text": "के दिनों में क्लौदियुस — प्रेरितों के काम 15:32"
  },
  {
   "tag": "p",
   "text": "नबी"
  },
  {
   "tag": "h3",
   "text": "सीलास"
  },
  {
   "tag": "p",
   "text": "यरूशलेम कलीसिया का एक प्रमुख सदस्य, पौलुस का साथी।"
  },
  {
   "tag": "p",
   "text": "के दिनों में क्लौदियुस — प्रेरितों के काम 15:32"
  },
  {
   "tag": "h2",
   "text": "पवित्रशास्त्र में जड़ें। खोज के लिए खुला।"
  },
  {
   "tag": "p",
   "text": "धीरे पढ़ने, गहराई से पूछने और संबंधों को खोजने की जगह। पवित्रशास्त्र, अध्ययन और ईसाई इतिहास की आवाज़ें, जीवन भर की सीख के लिए एक साथ।"
  },
  {
   "tag": "h3",
   "text": "वचन में समय बिताएँ"
  },
  {
   "tag": "li",
   "text": "पाठक खोलें"
  },
  {
   "tag": "li",
   "text": "पुस्तकें और पठन प्रगति"
  },
  {
   "tag": "li",
   "text": "पवित्रशास्त्र के संस्करणों की तुलना करें"
  },
  {
   "tag": "li",
   "text": "कोई अंश खोजें"
  },
  {
   "tag": "h3",
   "text": "अपने प्रश्नों को आगे बढ़ाएँ"
  },
  {
   "tag": "li",
   "text": "अध्ययन संग्रह"
  },
  {
   "tag": "li",
   "text": "लोग और स्थान"
  },
  {
   "tag": "li",
   "text": "विश्वास और धर्म-रक्षा"
  },
  {
   "tag": "li",
   "text": "विश्वास की कहानियाँ"
  },
  {
   "tag": "h3",
   "text": "एक पुस्तकालय जिसका कागज़ी मार्ग स्पष्ट है।"
  },
  {
   "tag": "p",
   "text": "लेखकों से मिलें। संग्रह खोजें। हर कृति को उसके स्रोत तक खोजें।"
  },
  {
   "tag": "h3",
   "text": "कोड डाउनलोड करें।"
  },
  {
   "tag": "p",
   "text": "GitHub पर खुला स्रोत।"
  },
  {
   "tag": "p",
   "text": "Bible Guide, Redeemer Forge, Inc. का एक कार्यक्रम है।"
  }
