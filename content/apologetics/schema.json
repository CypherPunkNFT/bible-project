  "$defs": {
    "citation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reference"
          ],
          "properties": {
            "kind": {
              "const": "scripture"
            },
            "reference": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "locator"
          ],
          "properties": {
            "kind": {
              "const": "source"
            },
            "source": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "locator": {
              "type": "string"
            }
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "citations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "text": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text",
        "citations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "reviewer",
        "kind",
        "scope",
        "contentHash",
        "basisHash",
        "note"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ai-assisted",
            "human"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "basisHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "topic",
        "summary",
        "answer",
        "passages",
        "related",
        "keywords"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "topic": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "summary": {
          "type": "string"
        },
        "format": {
          "enum": [
            "short-answer",
            "essay",
            "objections",
            "figure",
            "reading",
            "timeline",
            "debate-guide",
            "glossary",
            "faq",
            "case-study"
          ],
          "description": "Absent: today's short answer under today's rules. Declared: that format's fields and rules (scripts/content/formats.ts)."
        },
        "spine": {
          "enum": [
            "academic",
            "scripture-theology"
          ]
        },
        "alsoIn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true,
          "description": "Other fields (topic ids) that also list this study."
        },
        "debates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true,
          "description": "Debate ids whose hinge this study addresses."
        },
        "answer": {
          "$ref": "#/$defs/block"
        },
        "reasoning": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 2
        },
        "conclusion": {
          "$ref": "#/$defs/block"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          },
          "minItems": 1
        },
        "objection": {
          "type": "string"
        },
        "reply": {
          "$ref": "#/$defs/block"
        },
        "limit": {
          "$ref": "#/$defs/block"
        },
        "prompt": {
          "$ref": "#/$defs/block"
        },
        "passages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/passage"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "objections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectionPair"
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/essayPart"
          }
        },
        "figure": {
          "$ref": "#/$defs/figure"
        },
        "works": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/figureWork"
          }
        },
        "extracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extract"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timelineEvent"
          }
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/view"
          }
        },
        "common": {
          "$ref": "#/$defs/block"
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      },
      "description": "One article. Fields beyond the required seven depend on its format; scripts/content/formats.ts says which a format needs and allows."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "author",
        "kind",
        "url",
        "role",
        "note",
        "read",
        "checked"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "role": {
          "enum": [
            "Baptist confession",
            "Baptist exposition",
            "Reformed confession",
            "Reformed exposition",
            "Historic Christian witness",
            "Catholic contribution · limited scope",
            "Scholarship · described, not quoted",
            "Primary record · not a teaching authority"
          ]
        },
        "note": {
          "type": "string"
        },
        "read": {
          "type": "string",
          "description": "What was actually read of this source, and when; \"not recorded\" where no record says. Located is never presented as read. Kept out of the site data."
        },
        "checked": {
          "enum": [
            "corpus",
            "edition",
            "none"
          ],
          "description": "The text citations of this source are checked against: corpus = a copy this project holds; edition = a named edition read online; none = no text is checked or none is recorded (cite and describe only, never quote). Kept out of the site data."
        },
        "publicDomain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "edition",
            "basis"
          ],
          "properties": {
            "edition": {
              "type": "string",
              "minLength": 1,
              "description": "The edition or translation verified public domain; an extract must name exactly this edition."
            },
            "basis": {
              "type": "string",
              "minLength": 1,
              "description": "Why it is public domain: author and translator death years, first publication date, the copy checked."
            }
          },
          "description": "Only a source with this record may be quoted in a study's extracts (owner decision 3, 2026-11-27). Kept out of the site data."
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "short",
        "color",
        "description",
        "question"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "short": {
          "type": "string"
        },
        "color": {
          "enum": [
            "accent",
            "history",
            "poetry",
            "prophets",
            "gospels",
            "acts",
            "epistles",
            "revelation"
          ]
        },
        "description": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "start": {
          "description": "The three articles a field page shows first under Start here (plan APOLOGETICS-FIELDS job 5.2). Each is a published study of this field (its topic, or alsoIn).",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "label",
        "description",
        "studies"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "studies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "worldview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "description",
        "studies",
        "sources",
        "rows",
        "otherLabel"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "studies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "christian",
              "other",
              "study"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "question": {
                "type": "string"
              },
              "christian": {
                "$ref": "#/$defs/block"
              },
              "other": {
                "$ref": "#/$defs/block"
              },
              "study": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          },
          "minItems": 1
        },
        "otherLabel": {
          "type": "string"
        },
        "readingPlan": {
          "$ref": "#/$defs/readingPlan"
        }
      }
    },
    "debate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "speakers",
        "setting",
        "source",
        "lens",
        "description",
        "claim",
        "hinge",
        "prompts",
        "studies"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "speakers": {
          "type": "string"
        },
        "setting": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "lens": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/block"
        },
        "hinge": {
          "type": "string"
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "studies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "transcriptCoverage": {
          "type": "string",
          "minLength": 1
        },
        "recording": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "label",
            "credit",
            "duration",
            "note"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "credit": {
              "type": "string",
              "minLength": 1
            },
            "duration": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "context",
        "question",
        "options",
        "best",
        "explanation",
        "study",
        "prompt",
        "label"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "best": {
          "type": "integer",
          "minimum": 0
        },
        "explanation": {
          "$ref": "#/$defs/block"
        },
        "study": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "prompt": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "anchor",
        "foundations",
        "islamStudyQuestions",
        "conversationSteps",
        "policy",
        "copy"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "anchor": {
          "type": "string"
        },
        "foundations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "islamStudyQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conversationSteps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "line",
              "detail",
              "prompt",
              "reference"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "title": {
                "type": "string"
              },
              "line": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              }
            }
          },
          "minItems": 1
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "title",
            "introduction",
            "sections"
          ],
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "introduction": {
              "$ref": "#/$defs/block"
            },
            "sections": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/section"
              },
              "minItems": 1
            }
          }
        },
        "copy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "guideNote",
            "debateNote",
            "debateIndexNote",
            "sourceRoomIntro",
            "sourceRoomNote",
            "footerTitle",
            "footerText",
            "practiceNote"
          ],
          "properties": {
            "guideNote": {
              "type": "string"
            },
            "debateNote": {
              "type": "string"
            },
            "debateIndexNote": {
              "type": "string"
            },
            "sourceRoomIntro": {
              "type": "string"
            },
            "sourceRoomNote": {
              "type": "string"
            },
            "footerTitle": {
              "type": "string"
            },
            "footerText": {
              "type": "string"
            },
            "practiceNote": {
              "type": "string"
            }
          }
        }
      }
    },
    "readingPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "introduction",
        "stages"
      ],
      "properties": {
        "introduction": {
          "type": "string",
          "minLength": 1
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "aim",
              "readings"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "aim": {
                "type": "string",
                "minLength": 1
              },
              "readings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "title",
                    "context",
                    "purpose",
                    "examine",
                    "connection",
                    "christian"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "context": {
                      "$ref": "#/$defs/block"
                    },
                    "purpose": {
                      "$ref": "#/$defs/block"
                    },
                    "examine": {
                      "$ref": "#/$defs/block"
                    },
                    "connection": {
                      "$ref": "#/$defs/block"
                    },
                    "christian": {
                      "$ref": "#/$defs/block"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "note"
      ],
      "properties": {
        "reference": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "objectionPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "heldBy",
        "objection",
        "reply"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "heldBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Who makes this objection: people, schools or traditions, named."
        },
        "objection": {
          "type": "string",
          "description": "The objection in its holder's own terms."
        },
        "reply": {
          "$ref": "#/$defs/block"
        }
      }
    },
    "essayPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "blocks",
        "passages"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        },
        "passages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/passage"
          }
        }
      },
      "description": "One part of an essay, shown as its own page."
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dates",
        "tradition",
        "roles",
        "citations"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "dates": {
          "type": "string",
          "description": "As the cited source gives them."
        },
        "tradition": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "figureWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "date",
        "note"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "description": "A public-domain copy where one exists."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "extract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "locator",
        "edition",
        "translator",
        "text",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "locator": {
          "type": "string"
        },
        "edition": {
          "type": "string",
          "description": "The specific edition or translation, verified public domain (owner decision 3, 2026-11-27)."
        },
        "translator": {
          "type": "string",
          "description": "The translator, or that the text was written in English."
        },
        "text": {
          "type": "string",
          "description": "Public-domain text only. Its source must be checked against a held copy (corpus) or a named edition."
        },
        "note": {
          "$ref": "#/$defs/block"
        }
      }
    },
    "timelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "date",
        "certainty",
        "text",
        "citations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "certainty": {
          "enum": [
            "exact",
            "circa",
            "debated",
            "estimate"
          ]
        },
        "dateNote": {
          "type": "string",
          "description": "Required for a debated or estimated date: what the dispute or the estimate is."
        },
        "text": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "heldBy",
        "texts",
        "case",
        "reply"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string"
        },
        "heldBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "texts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/passage"
          }
        },
        "case": {
          "$ref": "#/$defs/block"
        },
        "reply": {
          "$ref": "#/$defs/block"
        }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "term",
        "text",
        "citations",
        "seeAlso"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "term": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "seeAlso": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "siteDefinition": {
          "type": "boolean",
          "description": "True when the definition is the site's own and cites nothing."
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "text",
        "citations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "question": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "study": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "The full article answering it, where one exists."
        }
      }
    }
  }
}
