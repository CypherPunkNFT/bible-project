  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "https-url"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "checkedOn": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "url",
        "locator",
        "note",
        "checkedOn"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ai-assisted",
            "human"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "date",
        "reviewer",
        "kind",
        "scope"
      ]
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "entityType": {
          "enum": [
            "person",
            "institution"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "cohort": {
          "type": "string",
          "minLength": 1
        },
        "traditions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "eligibility": {
          "enum": [
            "eligible",
            "provisional",
            "context-only",
            "excluded"
