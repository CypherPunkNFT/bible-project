        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review": {
          "$ref": "#/definitions/review"
        }
      },
      "required": [
        "id",
        "entityType",
        "name",
        "aliases",
        "cohort",
        "traditions",
        "eligibility",
        "rationale",
        "receptionBasis",
        "evidence",
        "distinctives",
        "unresolved",
        "review"
