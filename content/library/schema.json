        "id",
        "name",
        "url",
        "role",
        "automation",
        "acquisitionNote",
        "evidence",
        "reviewedOn"
      ]
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
