            "host": {
              "enum": [
                "allowed",
                "conditional",
                "denied",
                "unknown"
              ]
            },
            "redistribute": {
              "enum": [
                "allowed",
                "conditional",
                "denied",
                "unknown"
              ]
            },
            "adapt": {
              "enum": [
                "allowed",
                "conditional",
                "denied",
                "unknown"
              ]
            },
            "transcribe": {
              "enum": [
                "allowed",
                "conditional",
                "denied",
                "unknown"
              ]
            },
            "embed": {
              "enum": [
                "allowed",
                "conditional",
                "denied",
                "unknown"
              ]
            },
            "indexMetadata": {
              "enum": [
                "allowed",
                "conditional",
                "denied",
                "unknown"
              ]
            },
            "indexFullText": {
              "enum": [
                "allowed",
                "conditional",
                "denied",
                "unknown"
              ]
            }
          },
          "required": [
            "download",
            "host",
            "redistribute",
            "adapt",
            "transcribe",
            "embed",
            "indexMetadata",
            "indexFullText"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review": {
          "$ref": "#/definitions/review"
        }
      },
      "required": [
        "category",
        "jurisdiction",
        "licenseId",
        "licenseUrl",
        "attribution",
        "conditions",
        "conditionsMet",
        "actions",
        "evidence",
        "unresolved",
        "review"
      ]
