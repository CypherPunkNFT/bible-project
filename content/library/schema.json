    },
    {
      "$ref": "#/definitions/work"
    },
    {
      "$ref": "#/definitions/edition"
    },
    {
      "$ref": "#/definitions/asset"
    },
    {
      "$ref": "#/definitions/series"
    },
    {
      "$ref": "#/definitions/run"
    },
    {
      "$ref": "#/definitions/readingCollection"
    }
