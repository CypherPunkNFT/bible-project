    {
      "source": "kruger",
      "sourceId": "8010",
      "title": "Interested in Getting a Biblical Counseling Degree without Moving? You Can Do it @RTSCharlotte",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/interested-in-getting-a-biblical-counseling-degree-without-moving-now-you-can-do-it-rtscharlotte-3/",
      "sha256": "5b62fe7863539f853fa0fada17f50e4ca0168bd74c9f801686fd6e711ef98a27",
      "bytes": 4187,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\8010.html",
      "acquiredAt": "2026-10-07T20:14:01.154737+00:00",
