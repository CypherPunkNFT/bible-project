{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/1043b2626d09a86949b484c40b96cbb282d55bfd715a25c59426facc6950c87f?s=96&d=identicon&r=g\",\"url\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/1043b2626d09a86949b484c40b96cbb282d55bfd715a25c59426facc6950c87f?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/1043b2626d09a86949b484c40b96cbb282d55bfd715a25c59426facc6950c87f?s=96&d=identicon&r=g\",\"caption\":\"Michael Kruger\"},\"logo\":{\"@id\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/1043b2626d09a86949b484c40b96cbb282d55bfd715a25c59426facc6950c87f?s=96&d=identicon&r=g\"},\"sameAs\":[\"http:\\/\\/michaeljkruger.com\"]}]}</script>\n<!-- / Yoast SEO plugin. -->",
