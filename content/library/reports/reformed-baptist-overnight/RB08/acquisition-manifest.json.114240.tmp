        "yoast_head": "<!-- This site is optimized with the Yoast SEO plugin v28.5 - https://yoast.com/product/yoast-seo-wordpress/ -->\n<title>Provisionist Mythology Refuted with Full Documentation - Alpha and Omega Ministries</title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" />\n<link rel=\"canonical\" href=\"https://www.aomin.org/aoblog/the-dividing-line/provisionist-mythology-refuted-with-full-documentation/\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:title\" content=\"Provisionist Mythology Refuted with Full Documentation - Alpha and Omega Ministries\" />\n<meta property=\"og:description\" content=\"Spent two hours documenting the incredible mythology generated by Leighton Flowers and his guests regarding my supposed &#8220;Greek errors&#8221; over the past ten days. Everyone who has heard the stories should watch, take notes, and verify for yourselves. Truly, the end of the story, and time to move on. Hope you find it helpful!\" />\n<meta property=\"og:url\" content=\"https://www.aomin.org/aoblog/the-dividing-line/provisionist-mythology-refuted-with-full-documentation/\" />\n<meta property=\"og:site_name\" content=\"Alpha and Omega Ministries\" />\n<meta property=\"article:publisher\" content=\"https://www.facebook.com/aomin.org\" />\n<meta property=\"article:published_time\" content=\"2024-03-19T05:30:00+00:00\" />\n<meta property=\"og:image\" content=\"https://www.aomin.org/aoblog/wp-content/uploads/2020/06/Logo-red-e1591639042841.png\" />\n\t<meta property=\"og:image:width\" content=\"257\" />\n\t<meta property=\"og:image:height\" content=\"234\" />\n\t<meta property=\"og:image:type\" content=\"image/png\" />\n<meta name=\"author\" content=\"James White\" />\n<meta name=\"twitter:label1\" content=\"Written by\" />\n\t<meta name=\"twitter:data1\" content=\"James White\" />\n<script type=\"application/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\/\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/the-dividing-line\\/provisionist-mythology-refuted-with-full-documentation\\/#article\",\"isPartOf\":{\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/the-dividing-line\\/provisionist-mythology-refuted-with-full-documentation\\/\"},\"author\":{\"name\":\"James White\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#\\/schema\\/person\\/ae536bcc768adace3c384b380f52ce6f\"},\"headline\":\"Provisionist Mythology Refuted with Full Documentation\",\"datePublished\":\"2024-03-19T05:30:00+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/the-dividing-line\\/provisionist-mythology-refuted-with-full-documentation\\/\"},\"wordCount\":64,\"publisher\":{\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#organization\"},\"articleSection\":[\"Debate\",\"Exegesis\",\"Provisionism\",\"The Dividing Line\"],\"inLanguage\":\"en-US\"},{\"@type\":\"WebPage\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/the-dividing-line\\/provisionist-mythology-refuted-with-full-documentation\\/\",\"url\":\"https:\\/\\/www.aomin.org\\/aoblog\\/the-dividing-line\\/provisionist-mythology-refuted-with-full-documentation\\/\",\"name\":\"Provisionist Mythology Refuted with Full Documentation - Alpha and Omega Ministries\",\"isPartOf\":{\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#website\"},\"datePublished\":\"2024-03-19T05:30:00+00:00\",\"breadcrumb\":{\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/the-dividing-line\\/provisionist-mythology-refuted-with-full-documentation\\/#breadcrumb\"},\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"ReadAction\",\"target\":[\"https:\\/\\/www.aomin.org\\/aoblog\\/the-dividing-line\\/provisionist-mythology-refuted-with-full-documentation\\/\"]}]},{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/the-dividing-line\\/provisionist-mythology-refuted-with-full-documentation\\/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https:\\/\\/www.aomin.org\\/aoblog\\/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Provisionist Mythology Refuted with Full Documentation\"}]},{\"@type\":\"WebSite\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#website\",\"url\":\"https:\\/\\/www.aomin.org\\/aoblog\\/\",\"name\":\"Alpha and Omega Ministries\",\"description\":\"Toward a Defense of the Faith\",\"publisher\":{\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#organization\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\\/\\/www.aomin.org\\/aoblog\\/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":\"Organization\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#organization\",\"name\":\"Alpha and Omega Ministries\",\"url\":\"https:\\/\\/www.aomin.org\\/aoblog\\/\",\"logo\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#\\/schema\\/logo\\/image\\/\",\"url\":\"https:\\/\\/www.aomin.org\\/aoblog\\/wp-content\\/uploads\\/2020\\/06\\/Logo-red-e1591639042841.png\",\"contentUrl\":\"https:\\/\\/www.aomin.org\\/aoblog\\/wp-content\\/uploads\\/2020\\/06\\/Logo-red-e1591639042841.png\",\"width\":257,\"height\":234,\"caption\":\"Alpha and Omega Ministries\"},\"image\":{\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#\\/schema\\/logo\\/image\\/\"},\"sameAs\":[\"https:\\/\\/www.facebook.com\\/aomin.org\",\"https:\\/\\/x.com\\/AominOrg\",\"https:\\/\\/www.youtube.com\\/user\\/AominOrg\"]},{\"@type\":\"Person\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#\\/schema\\/person\\/ae536bcc768adace3c384b380f52ce6f\",\"name\":\"James White\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/25fcac95b93fd59cc7111111a8413bcaa46cdfb6ba2767c6adc55360d276311f?s=96&d=mm&r=pg\",\"url\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/25fcac95b93fd59cc7111111a8413bcaa46cdfb6ba2767c6adc55360d276311f?s=96&d=mm&r=pg\",\"contentUrl\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/25fcac95b93fd59cc7111111a8413bcaa46cdfb6ba2767c6adc55360d276311f?s=96&d=mm&r=pg\",\"caption\":\"James White\"},\"description\":\"James White is the director of Alpha and Omega Ministries, a Christian apologetics organization based in Phoenix, Arizona. He is the author of more than twenty four books, a professor, an accomplished debater.\",\"sameAs\":[\"http:\\/\\/www.aomin.org\\/\"],\"url\":\"https:\\/\\/www.aomin.org\\/aoblog\\/author\\/droakley\\/\"}]}</script>\n<!-- / Yoast SEO plugin. -->",
