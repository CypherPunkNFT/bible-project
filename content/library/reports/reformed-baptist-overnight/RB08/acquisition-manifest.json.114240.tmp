    {
      "source": "aomin",
      "sourceId": "35519",
      "title": "Further Thoughts on the Origins of the Term “Biblicism”",
      "author": "Alpha and Omega Ministries (author ID 31)",
      "url": "https://www.aomin.org/aoblog/church-history/further-thoughts-on-the-origins-of-the-term-biblicism/",
      "sha256": "85fdff8a89724fde8755aacf4e73bb272ed4fd74c5adb23e4154beee1ef45238",
      "bytes": 21829,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\aomin\\35519.html",
      "acquiredAt": "2026-10-07T20:13:13.963761+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
