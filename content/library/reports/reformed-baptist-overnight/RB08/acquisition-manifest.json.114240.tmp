        "title": {
          "rendered": "Provisionist Palaver, Trent Horn on Argumentation, A Few Moments with Carl Trueman and Doctrinal Development"
        },
        "content": {
          "rendered": "\n<p class=\"wp-block-paragraph\">My apologies for all the coughs and sniffs, I actually feel pretty good, but the voice and sinuses&#8212;not so much.  Spent time talking about God&#8217;s decree over against Provisionist palaver (look it up), then looked at some Trent Horn material in preparation for a few weeks from now, and finished up with a real quick section from the Carl Trueman presentation, this time on &#8220;doctrinal development.&#8221;</p>\n\n\n\n<iframe loading=\"lazy\" src=\"https://embed.sermonaudio.com/player/a/2124214128931/\" style=\"min-width: 150px;\" scrolling=\"no\" width=\"100%\" height=\"150\" frameborder=\"0\"></iframe>\n\n\n\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-4-3 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<iframe loading=\"lazy\" title=\"Provisionist Palaver, Trent Horn on Argumentation, Moments with Carl Trueman &amp; Doctrinal Development\" width=\"1200\" height=\"675\" src=\"https://www.youtube.com/embed/s_umKqnIIOo?feature=oembed&amp;wmode=opaque&amp;showinfo=0\" style=\"border: none\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen></iframe>\n</div></figure>\n",
          "protected": false
        },
        "excerpt": {
          "rendered": "<p>My apologies for all the coughs and sniffs, I actually feel pretty good, but the voice and sinuses&#8212;not so much. Spent time talking about God&#8217;s decree over against Provisionist palaver (look it up), then looked at some Trent Horn material in preparation for a few weeks from now, and finished up with a real quick section from the Carl Trueman [&hellip;]</p>\n",
          "protected": false
        },
