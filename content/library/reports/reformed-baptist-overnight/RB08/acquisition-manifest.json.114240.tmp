      "credit": "aomin",
      "sourceApi": "https://www.aomin.org/aoblog/wp-json/wp/v2/posts?per_page=100&page=4",
      "sourceMetadata": {
        "id": 34751,
        "date": "2023-10-26T20:21:08",
        "date_gmt": "2023-10-27T03:21:08",
        "guid": {
          "rendered": "https://www.aomin.org/aoblog/?p=34751"
        },
        "modified": "2023-10-26T20:21:17",
        "modified_gmt": "2023-10-27T03:21:17",
        "slug": "zach-lamberts-sermon-concluded",
        "status": "publish",
        "type": "post",
        "link": "https://www.aomin.org/aoblog/the-dividing-line/zach-lamberts-sermon-concluded/",
        "title": {
          "rendered": "Zach Lambert&#8217;s Sermon Concluded"
        },
        "content": {
          "rendered": "\n<p class=\"wp-block-paragraph\">Took two complete programs to do it, but we finished looking at Zach Lambert&#8217;s sermon on &#8220;Homophobia and Transphobia,&#8221; getting to the part where the Bible finally was referred to: and twisted into a pretzel. It is truly hard to listen to &#8220;progressivists&#8221; engage in societal eisegesis, but we sure got our fill in today&#8217;s 1:50 minute long program.</p>\n\n\n\n<iframe loading=\"lazy\" src=\"https://embed.sermonaudio.com/player/a/1026231856312927/\" style=\"min-width: 150px;\" scrolling=\"no\" width=\"100%\" height=\"150\" frameborder=\"0\"></iframe>\n\n\n\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-4-3 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<iframe loading=\"lazy\" title=\"Zach Lambert&#039;s Sermon Concluded\" width=\"1200\" height=\"900\" src=\"https://www.youtube.com/embed/F2wUIyojxmk?feature=oembed&amp;wmode=opaque&amp;showinfo=0\" style=\"border: none\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen></iframe>\n</div></figure>\n",
          "protected": false
        },
        "excerpt": {
          "rendered": "<p>Took two complete programs to do it, but we finished looking at Zach Lambert&#8217;s sermon on &#8220;Homophobia and Transphobia,&#8221; getting to the part where the Bible finally was referred to: and twisted into a pretzel. It is truly hard to listen to &#8220;progressivists&#8221; engage in societal eisegesis, but we sure got our fill in today&#8217;s 1:50 minute long program.</p>\n",
          "protected": false
        },
        "author": 3,
        "featured_media": 0,
        "comment_status": "closed",
        "ping_status": "closed",
        "sticky": false,
