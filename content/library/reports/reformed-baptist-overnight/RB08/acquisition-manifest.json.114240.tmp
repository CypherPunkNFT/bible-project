      "bytes": 5744,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\8231.html",
      "acquiredAt": "2026-10-07T20:13:58.638928+00:00",
