    {
      "source": "kruger",
      "sourceId": "7025",
      "title": "Will Ross Joins the Faculty of @RTSCharlotte as Assistant Professor of Old Testament",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/will-ross-joins-the-faculty-of-rtscharlotte-as-assistant-professor-of-old-testament/",
      "sha256": "b3ccdcab569be98fae02a69fa75d46c890013fa524870ace3b199c793602491d",
      "bytes": 3431,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\7025.html",
      "acquiredAt": "2026-10-07T20:14:29.022665+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
      "campaignMission": "RB08",
