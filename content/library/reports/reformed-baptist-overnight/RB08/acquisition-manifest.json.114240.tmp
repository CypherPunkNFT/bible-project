    {
      "source": "aomin",
      "sourceId": "37387",
      "title": "A Focused Method for Discussions with Jehovah’s Witnesses",
      "author": "Alpha and Omega Ministries (author ID 31)",
      "url": "https://www.aomin.org/aoblog/jehovahs-witnesses/a-focused-method-for-discussions-with-jehovahs-witnesses/",
      "sha256": "cd89510a798d1ce30388150527dc8b2635346edae0cec39df0d1afa49147b7e1",
      "bytes": 5744,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\aomin\\37387.html",
      "acquiredAt": "2026-10-07T20:12:49.656729+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
      "campaignMission": "RB08",
