      "sha256": "10ce34680d8b8d5a97c6a6f849ca9df7994aae7e93cc0f4377c2a36ef77cb8db",
      "bytes": 4288,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\9082.html",
      "acquiredAt": "2026-10-07T20:13:35.519014+00:00",
      "language": "en",
