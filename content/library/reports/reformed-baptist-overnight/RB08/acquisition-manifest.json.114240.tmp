    {
      "source": "kruger",
      "sourceId": "6836",
      "title": "Are Christians Ignorant, Uneducated, Simpletons?  Sort Of",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/are-christians-ignorant-uneducated-simpletons-sort-of/",
      "sha256": "02286fbe6a392c185a71612781840f56e87b8aa91561bd6bf6e9a55c621cb3d4",
      "bytes": 5217,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\6836.html",
      "acquiredAt": "2026-10-07T20:14:31.718102+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
      "campaignMission": "RB08",
