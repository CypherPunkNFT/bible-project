    {
      "source": "kruger",
      "sourceId": "8408",
      "title": "How to Run a Good Meeting–And Why it Matters More than You Think",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/how-to-run-a-good-meeting-and-why-it-matters-more-than-you-think-2/",
      "sha256": "5b16a3c2f2728b20e1b800ec445cf4e8c26974bcc5dabd80363aeab1e4ba4bea",
      "bytes": 10801,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\8408.html",
      "acquiredAt": "2026-10-07T20:13:56.013928+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
      "campaignMission": "RB08",
