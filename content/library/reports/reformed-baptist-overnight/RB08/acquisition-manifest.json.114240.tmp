      "sha256": "bc00139ac8dc66941b6770847833a67b7b5113134c44445ea8383174e9fc851d",
      "bytes": 6684,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\15822.html",
      "acquiredAt": "2026-10-07T20:12:44.889502+00:00",
