    {
      "source": "kruger",
      "sourceId": "8698",
      "title": "@RTSCharlotte 2020 Year in Review",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/rtscharlotte-2020-year-in-review/",
      "sha256": "7abcbd5da07f394ef47f36b984924200039162f22682dec0b4f6c38645df5499",
      "bytes": 7872,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\8698.html",
      "acquiredAt": "2026-10-07T20:13:50.976123+00:00",
