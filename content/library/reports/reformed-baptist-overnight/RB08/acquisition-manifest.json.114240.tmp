        "yoast_head": "<!-- This site is optimized with the Yoast SEO plugin v28.5 - https://yoast.com/product/yoast-seo-wordpress/ -->\n<title>Looking at Miracles Again: A Great New Book on David Hume - Canon Fodder</title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" />\n<link rel=\"canonical\" href=\"https://michaeljkruger.5mt.site/looking-at-miracles-again-a-great-new-book-on-david-hume/\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:title\" content=\"Looking at Miracles Again: A Great New Book on David Hume - Canon Fodder\" />\n<meta property=\"og:description\" content=\"In my most recent post, &#8220;Are Miracles Improbable? Rethinking What Makes Something &#8216;Likely&#8217; to Happen,&#8221; I analyzed (and critiqued) the main arguments against miracles.  And, like any discussion of miracles, I felt required to mention the work of Scottish philosopher David Hume. I can still remember walking by David Hume&#8217;s statue almost every day when [&hellip;]\" />\n<meta property=\"og:url\" content=\"https://michaeljkruger.5mt.site/looking-at-miracles-again-a-great-new-book-on-david-hume/\" />\n<meta property=\"og:site_name\" content=\"Canon Fodder\" />\n<meta property=\"article:published_time\" content=\"2019-10-07T12:31:00+00:00\" />\n<meta property=\"article:modified_time\" content=\"2023-04-14T21:58:16+00:00\" />\n<meta property=\"og:image\" content=\"https://5mt.michaeljkruger.com/2019/10/Hume-e1570451275907.jpg\" />\n\t<meta property=\"og:image:width\" content=\"1000\" />\n\t<meta property=\"og:image:height\" content=\"618\" />\n\t<meta property=\"og:image:type\" content=\"image/jpeg\" />\n<meta name=\"author\" content=\"Michael Kruger\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:label1\" content=\"Written by\" />\n\t<meta name=\"twitter:data1\" content=\"Michael Kruger\" />\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" />\n\t<meta name=\"twitter:data2\" content=\"3 minutes\" />\n<script type=\"application/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\/\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/looking-at-miracles-again-a-great-new-book-on-david-hume\\/#article\",\"isPartOf\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/looking-at-miracles-again-a-great-new-book-on-david-hume\\/\"},\"author\":{\"name\":\"Michael Kruger\",\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\"},\"headline\":\"Looking at Miracles Again: A Great New Book on David Hume\",\"datePublished\":\"2019-10-07T12:31:00+00:00\",\"dateModified\":\"2023-04-14T21:58:16+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/looking-at-miracles-again-a-great-new-book-on-david-hume\\/\"},\"wordCount\":680,\"commentCount\":1,\"publisher\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\"},\"image\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/looking-at-miracles-again-a-great-new-book-on-david-hume\\/#primaryimage\"},\"thumbnailUrl\":\"https:\\/\\/5mt.michaeljkruger.com\\/2019\\/10\\/Hume-e1570451275907.jpg\",\"keywords\":[\"David Hume\",\"James Anderson\",\"Miracles\"],\"articleSection\":[\"Apologetics\",\"Bible Difficulties\"],\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"CommentAction\",\"name\":\"Comment\",\"target\":[\"https:\\/\\/michaeljkruger.5mt.site\\/looking-at-miracles-again-a-great-new-book-on-david-hume\\/#respond\"]}]},{\"@type\":\"WebPage\",\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/looking-at-miracles-again-a-great-new-book-on-david-hume\\/\",\"url\":\"https:\\/\\/michaeljkruger.5mt.site\\/looking-at-miracles-again-a-great-new-book-on-david-hume\\/\",\"name\":\"Looking at Miracles Again: A Great New Book on Da