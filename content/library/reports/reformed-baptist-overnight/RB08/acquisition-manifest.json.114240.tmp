        "yoast_head": "<!-- This site is optimized with the Yoast SEO plugin v28.5 - https://yoast.com/product/yoast-seo-wordpress/ -->\n<title>Was the Divinity of Jesus a Late Invention of the Council of Nicea? - Canon Fodder</title>\n<meta name=\"description\" content=\"One of the most common objections to Christianity is that the divinity of Jesus was &quot;created&quot; by later Christians long after the first century.\" />\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" />\n<link rel=\"canonical\" href=\"https://michaeljkruger.5mt.site/was-the-divinity-of-jesus-a-late-invention-of-the-council-of-nicea/\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:title\" content=\"Was the Divinity of Jesus a Late Invention of the Council of Nicea? - Canon Fodder\" />\n<meta property=\"og:description\" content=\"One of the most common objections to Christianity is that the divinity of Jesus was &quot;created&quot; by later Christians long after the first century.\" />\n<meta property=\"og:url\" content=\"https://michaeljkruger.5mt.site/was-the-divinity-of-jesus-a-late-invention-of-the-council-of-nicea/\" />\n<meta property=\"og:site_name\" content=\"Canon Fodder\" />\n<meta property=\"article:published_time\" content=\"2020-09-21T13:24:08+00:00\" />\n<meta property=\"article:modified_time\" content=\"2023-04-14T21:59:54+00:00\" />\n<meta property=\"og:image\" content=\"https://5mt.michaeljkruger.com/2013/06/Council-of-Nicea-e1483979008342.jpg\" />\n\t<meta property=\"og:image:width\" content=\"975\" />\n\t<meta property=\"og:image:height\" content=\"405\" />\n\t<meta property=\"og:image:type\" content=\"image/jpeg\" />\n<meta name=\"author\" content=\"Michael Kruger\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:label1\" content=\"Written by\" />\n\t<meta name=\"twitter:data1\" content=\"Michael Kruger\" />\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" />\n\t<meta name=\"twitter:data2\" content=\"5 minutes\" />\n<script type=\"application/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\/\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/was-the-divinity-of-jesus-a-late-invention-of-the-council-of-nicea\\/#article\",\"isPartOf\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/was-the-divinity-of-jesus-a-late-invention-of-the-council-of-nicea\\/\"},\"author\":{\"name\":\"Michael Kruger\",\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\"},\"headline\":\"Was the Divinity of Jesus a Late Invention of the Council of Nicea?\",\"datePublished\":\"2020-09-21T13:24:08+00:00\",\"dateModified\":\"2023-04-14T21:59:54+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/was-the-divinity-of-jesus-a-late-invention-of-the-council-of-nicea\\/\"},\"wordCount\":1061,\"commentCount\":10,\"publisher\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\"},\"image\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/was-the-divinity-of-jesus-a-late-invention-of-the-council-of-nicea\\/#primaryimage\"},\"thumbnailUrl\":\"https:\\/\\/5mt.michaeljkruger.com\\/2013\\/06\\/Council-of-Nicea-e1483979008342.jpg\",\"keywords\":[\"Christology\",\"council of nicea\",\"Divinity of Jesus\",\"Jesus as God\",\"Larry Hurtado\",\"Richard Bauckham\"],\"articleSection\":[\"Divinity of Jesus\",\"Historical Jesus\"],\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"CommentAction\",\"name\":\"Comment\",\"target\":[\"https:\\/\\/michaeljkruger.5mt.site\\/was-the-divinity-of-jesus-a-late-invention-of-the-council-of-nicea\\/#respond\"]}]},{\"@type\":\"WebPage\",\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/was-the-divinity-of-jesus-a-late-invention-of-the-council-of-nicea\\/\",\"url