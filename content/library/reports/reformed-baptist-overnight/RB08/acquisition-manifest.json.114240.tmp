    {
      "source": "kruger",
      "sourceId": "7756",
      "title": "@RTSCharlotte 2019 Year in Review",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/rtscharlotte-2019-year-in-review/",
      "sha256": "c6bc0b3044b5e6f5b8043584df69ff7cf873d58cba1bb0276aa802e486a13f48",
      "bytes": 7723,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\7756.html",
      "acquiredAt": "2026-10-07T20:14:02.594171+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
      "campaignMission": "RB08",
