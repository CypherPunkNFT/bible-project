      "sha256": "4ed09241af8b256d3148c331ec3c28ead595f75ab24c8ca143b40b645d08eb28",
      "bytes": 4411,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\9815.html",
      "acquiredAt": "2026-10-07T20:13:22.682169+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
      "campaignMission": "RB08",
