    {
      "source": "kruger",
      "sourceId": "9408",
      "title": "Where Are All the Heretical Bishops in the Second Century?",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/where-are-all-the-heretical-bishops-in-the-second-century-2/",
      "sha256": "d3681afdf0940a1e523017ce5b98ce6ef8d045e5c48aa0095ef42d5917d3c3de",
      "bytes": 5024,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\9408.html",
      "acquiredAt": "2026-10-07T20:13:27.413109+00:00",
