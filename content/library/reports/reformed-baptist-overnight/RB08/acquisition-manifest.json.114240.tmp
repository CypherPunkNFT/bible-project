content=\"image/png\" />\n<meta name=\"author\" content=\"Chris Whisonant\" />\n<meta name=\"twitter:label1\" content=\"Written by\" />\n\t<meta name=\"twitter:data1\" content=\"Chris Whisonant\" />\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" />\n\t<meta name=\"twitter:data2\" content=\"15 minutes\" />\n<script type=\"application/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\/\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/reformed-apologetics\\/augustine-aquinas-and-the-council-of-orange-a-response-to-david-allen\\/#article\",\"isPartOf\":{\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/reformed-apologetics\\/augustine-aquinas-and-the-council-of-orange-a-response-to-david-allen\\/\"},\"author\":{\"name\":\"Chris Whisonant\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#\\/schema\\/person\\/60cc3d867a8ec07651472bfae9b77395\"},\"headline\":\"Augustine, Aquinas, and The Council of Orange: A response to David Allen\",\"datePublished\":\"2025-12-02T15:14:04+00:00\",\"dateModified\":\"2025-12-02T15:14:07+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/reformed-apologetics\\/augustine-aquinas-and-the-council-of-orange-a-response-to-david-allen\\/\"},\"wordCount\":3127,\"publisher\":{\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#organization\"},\"keywords\":[\"chrisw-davidallen\"],\"articleSection\":[\"Church History\",\"Provisionism\",\"Reformed Apologetics\"],\"inLanguage\":\"en-US\"},{\"@type\":\"WebPage\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/reformed-apologetics\\/augustine-aquinas-and-the-council-of-orange-a-response-to-david-allen\\/\",\"url\":\"https:\\/\\/www.aomin.org\\/aoblog\\/reformed-apologetics\\/augustine-aquinas-and-the-council-of-orange-a-response-to-david-allen\\/\",\"name\":\"Augustine, Aquinas, and The Council of Orange: A response to David Allen - Alpha and Omega Ministries\",\"isPartOf\":{\"@id\":\"https:\\/\\/www.aomin.org\\