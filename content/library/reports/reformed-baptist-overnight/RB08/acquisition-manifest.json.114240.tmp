    {
      "source": "kruger",
      "sourceId": "14015",
      "title": "What I’ll Be Up to at the TGC National Conference",
      "author": "Jana English",
      "url": "https://michaeljkruger.com/what-ill-be-up-to-at-the-tgc-national-conference/",
      "sha256": "682a99789bf7aed3bacb5b00efa13865566991307d6c042e1ddcdd56c0088551",
      "bytes": 3263,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\14015.html",
      "acquiredAt": "2026-10-07T20:13:05.262216+00:00",
      "language": "en",
