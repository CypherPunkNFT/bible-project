    },
    {
      "source": "aomin",
      "sourceId": "37293",
      "title": "Claiming “No one” believed something is dangerous!",
      "author": "Alpha and Omega Ministries (author ID 31)",
      "url": "https://www.aomin.org/aoblog/church-history/claiming-no-one-believed-something-is-dangerous/",
      "sha256": "0340848b8f7be6a95391c80df4f64008d63663213dde928376fc2631366dfc55",
      "bytes": 4359,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\aomin\\37293.html",
      "acquiredAt": "2026-10-07T20:12:49.794082+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
