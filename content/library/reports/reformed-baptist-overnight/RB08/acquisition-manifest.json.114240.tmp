rents\\/#primaryimage\"},\"thumbnailUrl\":\"https:\\/\\/5mt.michaeljkruger.com\\/2026\\/03\\/GNFD-4-Cover-scaled.jpg\",\"datePublished\":\"2026-03-23T15:18:33+00:00\",\"dateModified\":\"2026-03-23T20:28:42+00:00\",\"breadcrumb\":{\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/our-exciting-new-book-for-christian-parents\\/#breadcrumb\"},\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"ReadAction\",\"target\":[\"https:\\/\\/canonfodder.wpenginepowered.com\\/our-exciting-new-book-for-christian-parents\\/\"]}]},{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/our-exciting-new-book-for-christian-parents\\/#primaryimage\",\"url\":\"https:\\/\\/5mt.michaeljkruger.com\\/2026\\/03\\/GNFD-4-Cover-scaled.jpg\",\"contentUrl\":\"https:\\/\\/5mt.michaeljkruger.com\\/2026\\/03\\/GNFD-4-Cover-scaled.jpg\",\"width\":1885,\"height\":2560},{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/our-exciting-new-book-for-christian-parents\\/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https:\\/\\/michaeljkruger.com\\/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Our Exciting New Book for Christian Parents\"}]},{\"@type\":\"WebSite\",\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#website\",\"url\":\"https:\\/\\/michaeljkruger.5mt.site\\/\",\"name\":\"Canon Fodder\",\"description\":\"Exploring the origins of the New Testament canon and other biblical and theological issues\",\"publisher\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\\/\\/michaeljkruger.5mt.site\\/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":