\"position\":2,\"name\":\"John Owen&#8217;s Usage of Thomas Aquinas, Part 5\"}]},{\"@type\":\"WebSite\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#website\",\"url\":\"https:\\/\\/www.aomin.org\\/aoblog\\/\",\"name\":\"Alpha and Omega Ministries\",\"description\":\"Toward a Defense of the Faith\",\"publisher\":{\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#organization\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\\/\\/www.aomin.org\\/aoblog\\/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":\"Organization\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#organization\",\"name\":\"Alpha and Omega Ministries\",\"url\":\"https:\\/\\/www.aomin.org\\/aoblog\\/\",\"logo\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#\\/schema\\/logo\\/image\\/\",\"url\":\"https:\\/\\/www.aomin.org\\/aoblog\\/wp-content\\/uploads\\/2020\\/06\\/Logo-red-e1591639042841.png\",\"contentUrl\":\"https:\\/\\/www.aomin.org\\/aoblog\\/wp-content\\/uploads\\/2020\\/06\\/Logo-red-e1591639042841.png\",\"width\":257,\"height\":234,\"caption\":\"Alpha and Omega Ministries\"},\"image\":{\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#\\/schema\\/logo\\/image\\/\"},\"sameAs\":[\"https:\\/\\/www.facebook.com\\/aomin.org\",\"https:\\/\\/x.com\\/AominOrg\",\"https:\\/\\/www.youtube.com\\/user\\/AominOrg\"]},{\"@type\":\"Person\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#\\/schema\\/person\\/60cc3d867a8ec07651472bfae9b77395\",\"name\":\"Chris Whisonant\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/47c9bdfacd172b2f76fff2ad266b6999d98cbb0a9cf88792499b43aadc2de514?s=96&d=mm&r=pg\",\"url\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/47c9bdfacd172b2f76fff2ad266b6999d98cbb0a9cf88792499b43aadc2de514?s=96&d=mm&r=pg\",\"contentUrl\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/47c9bdfacd172b2f76fff2ad266b6999d98cbb0a9cf88792499b43aadc2de514?s=96&d=mm&r=pg\",\"caption\":\"Chris Whisonant\"},\"description\":\"Currently Vice President of Alpha and Omega Ministries, Chris is a husband, father of two, and lay leader in a Baptistic Congregation in Georgia. He writes at cwhisonant.wordpress.com where his current focus is on Baptism in the Early Church, his adventures in reading through Augustine's works.\",\"sameAs\":[\"https:\\/\\/cwhisonant.wordpress.com\"],\"url\":\"https:\\/\\/www.aomin.org\\/aoblog\\/author\\/cwhisonant\\/\"}]}</script>\n<!-- / Yoast SEO plugin. -->",
