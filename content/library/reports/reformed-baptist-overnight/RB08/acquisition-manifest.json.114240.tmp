now-the-christmas-story\\/#primaryimage\"},\"image\":{\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/think-you-know-the-christmas-story\\/#primaryimage\"},\"thumbnailUrl\":\"https:\\/\\/5mt.michaeljkruger.com\\/2023\\/12\\/Manger--scaled.jpg\",\"datePublished\":\"2023-12-11T14:17:14+00:00\",\"dateModified\":\"2023-12-17T21:52:39+00:00\",\"breadcrumb\":{\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/think-you-know-the-christmas-story\\/#breadcrumb\"},\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"ReadAction\",\"target\":[\"https:\\/\\/canonfodder.wpenginepowered.com\\/think-you-know-the-christmas-story\\/\"]}]},{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/think-you-know-the-christmas-story\\/#primaryimage\",\"url\":\"https:\\/\\/5mt.michaeljkruger.com\\/2023\\/12\\/Manger--scaled.jpg\",\"contentUrl\":\"https:\\/\\/5mt.michaeljkruger.com\\/2023\\/12\\/Manger--scaled.jpg\",\"width\":2560,\"height\":1439},{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/think-you-know-the-christmas-story\\/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https:\\/\\/michaeljkruger.com\\/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Think You Know the Christmas Story?\"}]},{\"@type\":\"WebSite\",\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#website\",\"url\":\"https:\\/\\/michaeljkruger.5mt.site\\/\",\"name\":\"Canon Fodder\",\"description\":\"Exploring the origins of the New Testament canon and other biblical and theological issues\",\"publisher\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\\/\\/michaeljkruger.5mt.site\\/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":[\"Person\",\"Organization\"],\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\",\"name\":\"Michael Kruger\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/1043b2626d09a86949b484c40b96cbb282d55bfd715a25c59426facc6950c87f?s=96&d=identicon&r=g\",\"url\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/1043b2626d09a86949b484c40b96cbb282d55bfd715a25c59426facc6950c87f?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/1043b2626d09a86949b484c40b96cbb282d55bfd715a25c59426facc6950c87f?s=96&d=identicon&r=g\",\"caption\":\"Michael Kruger\"},\"logo\":{\"@id\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/1043b2626d09a86949b484c40b96cbb282d55bfd715a25c59426facc6950c87f?s=96&d=identicon&r=g\"},\"sameAs\":[\"http:\\/\\/michaeljkruger.com\"]}]}</script>\n<!-- / Yoast SEO plugin. -->",
