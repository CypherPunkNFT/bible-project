    {
      "source": "kruger",
      "sourceId": "8448",
      "title": "Looking for a Lay-Level Class on the Origins of the NT Canon? Here’s my 6-Part Video Series with @Ligonier",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/looking-for-a-lay-level-class-on-the-origins-of-the-nt-canon-heres-my-6-part-video-series-with-ligonier/",
      "sha256": "7f277ceea89980dfb1786857c9a80799b8e1b134c054b88172295dd0ee1fc522",
      "bytes": 2980,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\8448.html",
      "acquiredAt": "2026-10-07T20:13:55.367017+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
