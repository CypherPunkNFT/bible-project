      "sourceApi": "https://www.aomin.org/aoblog/wp-json/wp/v2/posts?per_page=100&page=3",
      "sourceMetadata": {
        "id": 35387,
        "date": "2024-04-04T20:00:00",
        "date_gmt": "2024-04-05T03:00:00",
        "guid": {
          "rendered": "https://www.aomin.org/aoblog/?p=35387"
        },
        "modified": "2024-04-04T18:30:05",
        "modified_gmt": "2024-04-05T01:30:05",
        "slug": "in-memory-of-pastor-dennis-open-lines",
        "status": "publish",
        "type": "post",
        "link": "https://www.aomin.org/aoblog/the-dividing-line/in-memory-of-pastor-dennis-open-lines/",
        "title": {
          "rendered": "In Memory of Pastor Dennis, Open Lines"
        },
        "content": {
          "rendered": "\n<p class=\"wp-block-paragraph\">Started off giving thanks for the life of Pastor Dennis Pillay in Durban, South Africa, a dear brother who passed into glory last week.  Then we went to Zoom calls and covered topics such as the Descent of Christ, Catholic Answers, Christian YouTubers, the Lord&#8217;s Supper, philosophy and extra biblical language, and equal ultimacy.  In-depth questions!  We have an amazing audience!  An hour and twenty minutes today.</p>\n\n\n\n<iframe loading=\"lazy\" src=\"https://embed.sermonaudio.com/player/a/44242128515725/\" style=\"min-width: 150px;\" scrolling=\"no\" width=\"100%\" height=\"150\" frameborder=\"0\"></iframe>\n\n\n\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-4-3 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<iframe loading=\"lazy\" title=\"In Memory of Pastor Dennis, Open Lines\" width=\"1200\" height=\"900\" src=\"https://www.youtube.com/embed/TlRXb6JktuU?feature=oembed&amp;wmode=opaque&amp;showinfo=0\" style=\"border: none\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>\n</div></figure>\n",
          "protected": false
        },
        "excerpt": {
