    {
      "source": "kruger",
      "sourceId": "7624",
      "title": "How Dangerous is Money? A Great New Resource for Avoiding the Pitfalls",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/how-dangerous-is-money-a-great-new-resource-for-avoiding-the-pitfalls/",
      "sha256": "6148be841393af1e512c88f97719fe9759c26c16cb8b0f881d4f9b4c96819129",
      "bytes": 5359,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\7624.html",
