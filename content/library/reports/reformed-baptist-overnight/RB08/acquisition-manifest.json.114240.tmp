      "sha256": "8c5bf987c6d97337feed75a2972417d234f18f79b187a8f8d49094c2569ff7f6",
      "bytes": 5931,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\9443.html",
