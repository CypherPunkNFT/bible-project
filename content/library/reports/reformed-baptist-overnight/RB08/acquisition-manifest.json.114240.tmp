        "title": {
          "rendered": "The Changing World of Mormonism"
        },
        "content": {
          "rendered": "\n<p class=\"wp-block-paragraph\">Went in the big studio today to talk about Mormonism and the challenges we face today in seeking to witness of the truth to members of the LDS Church.  Did a good bit of reminiscing along the path, since the first books I read and studied from the LDS Church were purchased 41 years ago now.  Had them in studio as well!</p>\n\n\n\n<iframe loading=\"lazy\" src=\"https://embed.sermonaudio.com/player/a/62023141140606/\" style=\"min-width: 150px;\" scrolling=\"no\" width=\"100%\" height=\"150\" frameborder=\"0\"></iframe>\n\n\n\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-16-9 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<iframe loading=\"lazy\" title=\"The Changing World of Mormonism\" width=\"1200\" height=\"675\" src=\"https://www.youtube.com/embed/juNOh8CEelc?feature=oembed&amp;wmode=opaque&amp;showinfo=0\" style=\"border: none\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen></iframe>\n</div></figure>\n",
          "protected": false
        },
        "excerpt": {
          "rendered": "<p>Went in the big studio today to talk about Mormonism and the challenges we face today in seeking to witness of the truth to members of the LDS Church. Did a good bit of reminiscing along the path, since the first books I read and studied from the LDS Church were purchased 41 years ago now. Had them in studio [&hellip;]</p>\n",
          "protected": false
        },
