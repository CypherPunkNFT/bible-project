    {
      "source": "kruger",
      "sourceId": "16471",
      "title": "Parenting Lesson #1: God Works Through Families",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/parenting-lesson-1-god-works-through-families/",
      "sha256": "2b5737431feb3c2ccde573470ac420ec92d806a27e9552cfa60571b8041ba2ba",
      "bytes": 7398,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\16471.html",
      "acquiredAt": "2026-10-07T20:12:43.913492+00:00",
      "language": "en",
