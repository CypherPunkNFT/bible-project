    {
      "source": "kruger",
      "sourceId": "8786",
      "title": "What If I Can’t Answer Questions about My Faith?",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/what-if-i-cant-answer-questions-about-my-faith/",
      "sha256": "f83f1c6cb777a608a5e2b315e231514f318fbbdf751c8bb14bfbeb9770a8e037",
