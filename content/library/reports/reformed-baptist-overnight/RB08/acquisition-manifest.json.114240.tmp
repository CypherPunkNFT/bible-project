    {
      "source": "kruger",
      "sourceId": "7286",
      "title": "@RTSCharlotte Vision Banquet with @SandraMcCracken",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/rtscharlotte-vision-banquet-with-sandramccracken/",
      "sha256": "cf1ac17d1032da0fece30ebaadf843a59bc78345cf5cda11c84cc5f442a66287",
      "bytes": 10592,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\7286.html",
      "acquiredAt": "2026-10-07T20:14:23.349869+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
      "campaignMission": "RB08",
      "licence": "Copyright retained by author/ministry; publicly offered written material; private local research copy; original notices and credits retained",
