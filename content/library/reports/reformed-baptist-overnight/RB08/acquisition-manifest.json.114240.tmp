    {
      "source": "kruger",
      "sourceId": "8343",
      "title": "An Amazing New Children’s Book",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/an-amazing-new-childrens-book/",
      "sha256": "42e8f84366f8a8ec281747d33a5f28cba1126b974724809492bd43ca9d805ec2",
      "bytes": 5362,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\8343.html",
      "acquiredAt": "2026-10-07T20:13:57.091109+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
      "campaignMission": "RB08",
