      "sourceApi": "https://www.aomin.org/aoblog/wp-json/wp/v2/posts?per_page=100&page=5",
      "sourceMetadata": {
        "id": 34130,
        "date": "2023-05-10T18:31:10",
        "date_gmt": "2023-05-11T01:31:10",
        "guid": {
          "rendered": "https://www.aomin.org/aoblog/?p=34130"
        },
        "modified": "2023-05-10T18:31:18",
        "modified_gmt": "2023-05-11T01:31:18",
        "slug": "more-attempts-at-sneaking-mans-autonomy-into-scripture",
        "status": "publish",
        "type": "post",
        "link": "https://www.aomin.org/aoblog/the-dividing-line/more-attempts-at-sneaking-mans-autonomy-into-scripture/",
        "title": {
          "rendered": "More Attempts at Sneaking Man&#8217;s Autonomy into Scripture"
        },
        "content": {
          "rendered": "\n<p class=\"wp-block-paragraph\">After a brief review of a further comment by Stephen Wolfe (that I missed on the last show), we went back to Ephesians 1 after listening to a monologue by Leighton Flowers seeking to establish synergism by&#8230;assuming it!  Brought Accordance in once again and dove into the text.  Had one little interruption (the kind lady who runs the RV park, well, needed payment!) but other than that everything went smoothly from the new studio!  Rich also announced how the auction for the Jeffrey Rice rebind will be run (after he found the Bible that is!).  We may be able to sneak a program in on Friday, hopefully!</p>\n\n\n\n<iframe loading=\"lazy\" src=\"https://embed.sermonaudio.com/player/a/51023232983149/\" style=\"min-width: 150px;\" scrolling=\"no\" width=\"100%\" height=\"150\" frameborder=\"0\"></iframe>\n\n\n\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-16-9 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<iframe loading=\"lazy\" title=\"More Attempts at Sneaking Man&#039;s Autonomy into Scripture\" width=\"1200\" height=\"675\" src=\"https://www.youtube.com/embed/ne9WsPBe2GE?feature=oembed&amp;wmode=opaque&amp;showinfo=0\" style=\"border: none\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen></iframe>\n</div></figure>\n",
          "protected": false
        },
        "excerpt": {
