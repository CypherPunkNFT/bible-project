      "bytes": 4089,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\7542.html",
      "acquiredAt": "2026-10-07T20:14:05.414556+00:00",
