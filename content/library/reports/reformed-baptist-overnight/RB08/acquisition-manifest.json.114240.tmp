    {
      "source": "kruger",
      "sourceId": "7698",
      "title": "A Tribute to Larry Hurtado: Scholar, Doktorvater, and Friend",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/a-tribute-to-larry-hurtado-scholar-doktorvater-and-friend/",
      "sha256": "1cc30e354ac40cfe490a458e7cec20c1e1532be5e907ddeb2c33d316725877f5",
      "bytes": 3625,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\7698.html",
      "acquiredAt": "2026-10-07T20:14:03.097352+00:00",
      "language": "en",
