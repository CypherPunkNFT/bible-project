ue,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":[\"Person\",\"Organization\"],\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\",\"name\":\"Michael Kruger\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/1043b2626d09a86949b484c40b96cbb282d55bfd715a25c59426facc6950c87f?s=96&d=identicon&r=g\",\"url\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/1043b2626d09a86949b484c40b96cbb282d55bfd715a25c59426facc6950c87f?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/1043b2626d09a86949b484c40b96cbb282d55bfd715a25c59426facc6950c87f?s=96&d=identicon&r=g\",\"caption\":\"Michael Kruger\"},\"logo\":{\"@id\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/1043b2626d09a86949b484c40b96cbb282d55bfd715a25c59426facc6950c87f?s=96&d=identicon&r=g\"},\"sameAs\":[\"http:\\/\\/michaeljkruger.com\"]},{\"@type\":\"Person\",\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/c4959a07543398ef7687a8a95ac2d1c8\",\"name\":\"Danielle Belcher\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/af262c8df88e14bfbf646bbdd4d22dd2a040298a08ed0b8be62b6c63363ff66e?s=96&d=identicon&r=g\",\"url\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/af262c8df88e14bfbf646bbdd4d22dd2a040298a08ed0b8be62b6c63363ff66e?s=96&d=identicon&r=g\",\"contentUrl\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/af262c8df88e14bfbf646bbdd4d22dd2a040298a08ed0b8be62b6c63363ff66e?s=96&d=identicon&r=g\",\"caption\":\"Danielle Belcher\"}}]}</script>\n<!-- / Yoast SEO plugin. -->",
