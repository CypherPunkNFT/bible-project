    {
      "source": "kruger",
      "sourceId": "10308",
      "title": "6 Ways that Christian Students Can Prepare for College: #2 You Won’t Have All the Answers",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/6-ways-that-christian-students-can-prepare-for-college-2-you-wont-have-all-the-answers/",
      "sha256": "5d548f15a76e5bff2ccd386764fb6af60eefa52528f9fff7b220bbbd79392fdd",
      "bytes": 5285,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\10308.html",
      "acquiredAt": "2026-10-07T20:13:06.756223+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
