      "bytes": 4970,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\8175.html",
      "acquiredAt": "2026-10-07T20:13:59.287731+00:00",
