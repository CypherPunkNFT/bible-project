mbering-tim-keller\\/#breadcrumb\"},\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"ReadAction\",\"target\":[\"https:\\/\\/canonfodder.wpenginepowered.com\\/remembering-tim-keller\\/\"]}]},{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/remembering-tim-keller\\/#primaryimage\",\"url\":\"https:\\/\\/5mt.michaeljkruger.com\\/2024\\/05\\/Keller.jpg\",\"contentUrl\":\"https:\\/\\/5mt.michaeljkruger.com\\/2024\\/05\\/Keller.jpg\",\"width\":1500,\"height\":637},{\"@type\":\"BreadcrumbList\",\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/remembering-tim-keller\\/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https:\\/\\/michaeljkruger.com\\/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Remembering Tim Keller\"}]},{\"@type\":\"WebSite\",\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#website\",\"url\":\"https:\\/\\/michaeljkruger.5mt.site\\/\",\"name\":\"Canon Fodder\",\"description\":\"Exploring the origins of the New Testament canon and other biblical and theological issues\",\"publisher\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\"},\"potentialAction\":[{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https:\\/\\/michaeljkruger.5mt.site\\/?s={search_term_string}\"},\"query-input\":{\"@type\":\"PropertyValueSpecification\",\"valueRequired\":true,\"valueName\":\"search_term_string\"}}],\"inLanguage\":\"en-US\"},{\"@type\":[\"Person\",\"Organization\"],\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\",\"name\":\"Michael Kruger\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/1043b2626d09a86949b484c40b96cbb282d55bfd715a25c59426facc6950c87f?s=96&d=identicon&r=g\",\"url\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/104