    {
      "source": "kruger",
      "sourceId": "9382",
      "title": "Thankful for Larry W. Hurtado",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/thankful-for-larry-w-hurtado/",
      "sha256": "ed957fb6a255a1e1570780472a267bd7082d4d111b7c444da6a59d7cc3d9efe8",
      "bytes": 5267,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\9382.html",
      "acquiredAt": "2026-10-07T20:13:27.726602+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
