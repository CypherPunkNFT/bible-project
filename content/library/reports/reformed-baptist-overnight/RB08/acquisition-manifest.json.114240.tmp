data-orig-size=\"3000,2003\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;4&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;NIKON D750&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;1553801990&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;200&quot;,&quot;iso&quot;:&quot;1600&quot;,&quot;shutter_speed&quot;:&quot;0.005&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;1&quot;}\" data-image-title=\"RTS-Banquet-2019-I\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://5mt.michaeljkruger.com/2019/03/RTS-Banquet-2019-I-1024x684.jpg\" class=\"wp-image-7297 alignleft\" src=\"https://5mt.michaeljkruger.com/2019/03/RTS-Banquet-2019-I.jpg\" alt=\"\" width=\"836\" height=\"558\" srcset=\"https://5mt.michaeljkruger.com/2019/03/RTS-Banquet-2019-I.jpg 3000w, https://5mt.michaeljkruger.com/2019/03/RTS-Banquet-2019-I-400x267.jpg 400w, https://5mt.michaeljkruger.com/2019/03/RTS-Banquet-2019-I-768x513.jpg 768w, https://5mt.michaeljkruger.com/2019/03/RTS-Banquet-2019-I-1024x684.jpg 1024w\" sizes=\"(max-width: 836px) 100vw, 836px\" /></p>\n<p><img loading=\"lazy\" decoding=\"async\" data-attachment-id=\"7296\" data-permalink=\"https://michaeljkruger.com/rtscharlotte-vision-banquet-with-sandramccracken/rts-banquet-2019-h/\" data-orig-file=\"https://5mt.michaeljkruger.com/2019/03/RTS-Banquet-2019-H.jpg\" data-orig-size=\"3000,2003\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;4&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;NIKON D750&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;1553804086&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;95&quot;,&quot;iso&quot;:&quot;2500&quot;,&quot;shutter_speed&quot;:&quot;0.005&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;1&quot;}\" data-image-title=\"RTS-Banquet-2019-H\" data-image-descript