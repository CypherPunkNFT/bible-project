log\\/#\\/schema\\/person\\/ae536bcc768adace3c384b380f52ce6f\",\"name\":\"James White\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/25fcac95b93fd59cc7111111a8413bcaa46cdfb6ba2767c6adc55360d276311f?s=96&d=mm&r=pg\",\"url\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/25fcac95b93fd59cc7111111a8413bcaa46cdfb6ba2767c6adc55360d276311f?s=96&d=mm&r=pg\",\"contentUrl\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/25fcac95b93fd59cc7111111a8413bcaa46cdfb6ba2767c6adc55360d276311f?s=96&d=mm&r=pg\",\"caption\":\"James White\"},\"description\":\"James White is the director of Alpha and Omega Ministries, a Christian apologetics organization based in Phoenix, Arizona. He is the author of more than twenty four books, a professor, an accomplished debater.\",\"sameAs\":[\"http:\\/\\/www.aomin.org\\/\"],\"url\":\"https:\\/\\/www.aomin.org\\/aoblog\\/author\\/droakley\\/\"}]}</script>\n<!-- / Yoast SEO plugin. -->",
