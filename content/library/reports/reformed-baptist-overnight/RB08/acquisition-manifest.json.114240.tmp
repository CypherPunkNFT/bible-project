    {
      "source": "kruger",
      "sourceId": "8391",
      "title": "Seeing What We Want to See: Reflections on the Saga of the Gospel of Jesus’ Wife",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/seeing-what-we-want-to-see-reflections-on-the-saga-of-the-gospel-of-jesus-wife/",
      "sha256": "8f9531f383f288c0fbf8bcfc10e03026dad8c7425f57f1eb8b3dd9247ab6e1af",
      "bytes": 9082,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\8391.html",
      "acquiredAt": "2026-10-07T20:13:56.234777+00:00",
