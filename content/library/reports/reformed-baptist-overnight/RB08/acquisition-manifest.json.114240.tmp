        "title": {
          "rendered": "Dr. Carl Trueman&#8217;s Inaugural Address at the Center for Classical Theology"
        },
        "content": {
          "rendered": "\n<p class=\"wp-block-paragraph\">Started to listen to and interact with Dr. Carl Trueman&#8217;s inaugural address at the Center for Classical Theology.  Got into the heart of the matter, Scripture, tradition, authority, etc., after playing a number of statements that were insightful, useful, and edifying.  Will continue on Thursday!  You can listen to the lecture <a href=\"https://youtu.be/GubwG5aU-ss\">here</a>.  <br><br></p>\n\n\n\n<iframe loading=\"lazy\" src=\"https://embed.sermonaudio.com/player/a/12424127587855/\" style=\"min-width: 150px;\" scrolling=\"no\" width=\"100%\" height=\"150\" frameborder=\"0\"></iframe>\n\n\n\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-4-3 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<iframe loading=\"lazy\" title=\"Dr. Carl Trueman&#039;s Inaugural Address at the Center for Classical Theology\" width=\"1200\" height=\"675\" src=\"https://www.youtube.com/embed/NRVTfKk2zD4?feature=oembed&amp;wmode=opaque&amp;showinfo=0\" style=\"border: none\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen></iframe>\n</div></figure>\n",
          "protected": false
        },
        "excerpt": {
          "rendered": "<p>Started to listen to and interact with Dr. Carl Trueman&#8217;s inaugural address at the Center for Classical Theology. Got into the heart of the matter, Scripture, tradition, authority, etc., after playing a number of statements that were insightful, useful, and edifying. Will continue on Thursday! You can listen to the lecture here.</p>\n",
          "protected": false
        },
