      "sha256": "62b6c264a89c3e751b14c2b65b6513af17a79c4588c86856a55b30fb94b3b487",
      "bytes": 2867,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\7434.html",
      "acquiredAt": "2026-10-07T20:14:19.980282+00:00",
