    {
      "source": "kruger",
      "sourceId": "9469",
      "title": "New Book: 5 Things to Pray For Your Spouse",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/new-book-5-things-to-pray-for-your-spouse/",
      "sha256": "e4f73bf7f72c6a4351a3c6d5ab70c8ae1498661cc7bb88c20e9354793b5872fd",
      "bytes": 5582,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\9469.html",
      "acquiredAt": "2026-10-07T20:13:26.765406+00:00",
