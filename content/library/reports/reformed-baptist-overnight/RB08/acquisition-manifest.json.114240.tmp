    {
      "source": "kruger",
      "sourceId": "7091",
      "title": "What Do Contentment, Identity, and Joy Have in Common?  Three Great New Resources",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/what-do-contentment-identity-and-joy-have-in-common-three-great-new-resources/",
      "sha256": "cf9ef8f7c8a092c2b3aa662499a0790cf9770450f27ddc93ec0073f4c00f3048",
      "bytes": 5581,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\7091.html",
      "acquiredAt": "2026-10-07T20:14:27.654072+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
