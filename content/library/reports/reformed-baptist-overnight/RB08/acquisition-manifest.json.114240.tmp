    {
      "source": "kruger",
      "sourceId": "7681",
      "title": "Off to San Diego for the Annual Meeting of the Evangelical Theological Society",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/off-to-san-diego-for-the-annual-meeting-of-the-evangelical-theological-society/",
      "sha256": "ea93c0005b006c68455311a6e06003a4ed7a50b88e78698ad67643582acbbe38",
      "bytes": 2460,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\7681.html",
      "acquiredAt": "2026-10-07T20:14:03.362896+00:00",
