      "bytes": 3756,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\8565.html",
      "acquiredAt": "2026-10-07T20:13:54.713451+00:00",
