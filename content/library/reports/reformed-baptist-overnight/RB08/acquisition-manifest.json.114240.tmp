    {
      "source": "kruger",
      "sourceId": "14958",
      "title": "One of the Most Important Ministry Skills That Nobody Talks About",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/one-of-the-most-important-ministry-skills-that-nobody-talks-about/",
      "sha256": "3f64e4da88f80d7ee8c8468101f6929f9ea0d97af1182ede489e193ca33452d4",
      "bytes": 11019,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\14958.html",
      "acquiredAt": "2026-10-07T20:12:46.191373+00:00",
