      "sha256": "acb1edebb20f34cc80c51220d7ed8709f0f697c246ed99af77acb92ef881302c",
      "bytes": 3474,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\8848.html",
      "acquiredAt": "2026-10-07T20:13:46.718266+00:00",
