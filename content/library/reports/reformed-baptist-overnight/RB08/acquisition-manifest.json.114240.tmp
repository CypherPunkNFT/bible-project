      "title": "Book Notice: Can We Trust the Gospels?",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/book-notice-can-we-trust-the-gospels/",
      "sha256": "d327be54b77ddf3445dc9f1853a6c71b6690d30e245ea1cb59e457f4479e32ac",
      "bytes": 5639,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\7050.html",
      "acquiredAt": "2026-10-07T20:14:28.442047+00:00",
