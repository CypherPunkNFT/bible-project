    {
      "source": "kruger",
      "sourceId": "7907",
      "title": "One of the Most Overlooked Reasons Why We Should Trust the Bible",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/one-of-the-most-overlooked-reasons-why-we-should-trust-the-bible/",
      "sha256": "1a433fc656f43a901c03c32372cc5e24be5341d891d4dcaa7c966e6287b904f6",
      "bytes": 5892,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\7907.html",
      "acquiredAt": "2026-10-07T20:14:01.874855+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
      "campaignMission": "RB08",
