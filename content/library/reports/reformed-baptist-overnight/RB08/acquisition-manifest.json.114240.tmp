 name=\"twitter:label1\" content=\"Written by\" />\n\t<meta name=\"twitter:data1\" content=\"Michael Kruger\" />\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" />\n\t<meta name=\"twitter:data2\" content=\"4 minutes\" />\n<script type=\"application/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\/\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/how-a-you-do-you-culture-has-made-us-vulnerable-to-the-coronavirus\\/#article\",\"isPartOf\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/how-a-you-do-you-culture-has-made-us-vulnerable-to-the-coronavirus\\/\"},\"author\":{\"name\":\"Michael Kruger\",\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\"},\"headline\":\"How a &#8220;You do You&#8221; Culture Has Made Us Vulnerable to the Coronavirus\",\"datePublished\":\"2020-03-19T20:34:16+00:00\",\"dateModified\":\"2023-04-14T21:59:10+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/how-a-you-do-you-culture-has-made-us-vulnerable-to-the-coronavirus\\/\"},\"wordCount\":930,\"commentCount\":28,\"publisher\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\"},\"image\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/how-a-you-do-you-culture-has-made-us-vulnerable-to-the-coronavirus\\/#primaryimage\"},\"thumbnailUrl\":\"https:\\/\\/5mt.michaeljkruger.com\\/2020\\/03\\/coronavirus-e1584649768167.jpg\",\"keywords\":[\"\\\" self-sacrifice\",\"\\\"You do you\",\"coronavirus\",\"Morality\",\"worldviews\"],\"articleSection\":[\"Culture &amp; Politics\",\"Ethics &amp; Morality\"],\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"CommentAction\",\"name\":\"Comment\",\"target\":[\"https:\\/\\/michaeljkruger.5mt.site\\/how-a-you-do-you-culture-has-made-us-vulnerable-to-the-coronavirus\\/#respond\"]}]},{\"@type\":\"WebPage\",\"@id\":\"https:\\/\\/michaeljkruger.5mt