    {
      "source": "kruger",
      "sourceId": "10129",
      "title": "“Bully Pulpit” Wins Book of the Year",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/bully-pulpit-wins-book-of-the-year/",
      "sha256": "05495d4f0bb52d049c641c4cf4fa881b9413c9a4b4ce69a249a10add3b18df12",
      "bytes": 7084,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\10129.html",
