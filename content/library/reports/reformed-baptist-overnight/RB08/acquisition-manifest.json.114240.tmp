    {
      "source": "kruger",
      "sourceId": "8638",
      "title": "What is Covenant Theology? Here are Two New Resources You Don’t Want to Miss",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/what-is-covenant-theology-here-are-two-new-resources-you-dont-want-to-miss-2/",
      "sha256": "65dbd9a1227c73e6eeb9f0ea9e1216546475d1f78dbd8c915198130623c7202d",
      "bytes": 4785,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\8638.html",
      "acquiredAt": "2026-10-07T20:13:54.053366+00:00",
