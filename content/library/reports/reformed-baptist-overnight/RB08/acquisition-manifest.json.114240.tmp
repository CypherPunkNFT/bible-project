    {
      "source": "kruger",
      "sourceId": "6864",
      "title": "Coming Home: @RTSCharlotte Alums Who are Now Professors at RTS",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/coming-home-rtscharlotte-alums-who-are-now-professors-at-rts/",
      "sha256": "35d4aab9484d530c9132739de22fd7f48c1e3cfab7ddbeee3c615a43355e1063",
      "bytes": 4001,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\6864.html",
      "acquiredAt": "2026-10-07T20:14:31.437767+00:00",
      "language": "en",
