      "sha256": "929da88031c8b3ac2b6f4f340da00f1b44c1ff7f57f215356763fbbe63e8e5bd",
      "bytes": 4070,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\6831.html",
      "acquiredAt": "2026-10-07T20:14:32.322444+00:00",
