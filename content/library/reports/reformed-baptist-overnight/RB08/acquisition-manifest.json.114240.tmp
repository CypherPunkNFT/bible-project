    {
      "source": "kruger",
      "sourceId": "9090",
      "title": "Don’t Miss These @RTSCharlotte Summer 2021 Courses",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/dont-miss-these-rtscharlotte-summer-2021-courses/",
      "sha256": "b2e7fe94d6d7479085e8d4dd3e8a6bdc884175e2ae8d4d1c6ac6e75b92c92e8d",
      "bytes": 4499,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\9090.html",
      "acquiredAt": "2026-10-07T20:13:35.341053+00:00",
