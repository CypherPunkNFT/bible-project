    {
      "source": "kruger",
      "sourceId": "7135",
      "title": "Want to Give a Book for Christmas? Here’s My Top Ten List for Books on the Authority of Scripture",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/want-to-give-a-book-for-christmas-heres-my-top-ten-list-for-books-on-the-authority-of-scripture/",
      "sha256": "2b0deb224ba9b4d6439031eaee2c5e46531d60c0b2e3d5e8b6e43525c6bcf090",
      "bytes": 10777,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\7135.html",
      "acquiredAt": "2026-10-07T20:14:26.597979+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
      "campaignMission": "RB08",
