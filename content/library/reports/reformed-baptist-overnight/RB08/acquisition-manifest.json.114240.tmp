    {
      "source": "kruger",
      "sourceId": "8565",
      "title": "Surviving Doubt: Six Videos Providing Answers to Difficult Questions about the Christian Faith",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/surviving-doubt-six-videos-providing-answers-to-difficult-questions-about-the-christian-faith/",
