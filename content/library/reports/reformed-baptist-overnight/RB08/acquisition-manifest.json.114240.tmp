        "yoast_head": "<!-- This site is optimized with the Yoast SEO plugin v28.5 - https://yoast.com/product/yoast-seo-wordpress/ -->\n<title>One of the Most Remarkable Features of Early Christian Manuscripts - Canon Fodder</title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" />\n<link rel=\"canonical\" href=\"https://canonfodder.wpenginepowered.com/one-of-the-most-remarkable-features-of-early-christian-manuscripts/\" />\n<meta property=\"og:locale\" content=\"en_US\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"og:title\" content=\"One of the Most Remarkable Features of Early Christian Manuscripts - Canon Fodder\" />\n<meta property=\"og:description\" content=\"One of my favorite electives I teach here at RTS Charlotte is &#8220;The Origin and Authority of the New Testament Canon.&#8221; We cover a lot of ground in that course: why we have a NT canon, what is the earliest evidence for a canon consciousness, what were the factors that led to the church receiving [&hellip;]\" />\n<meta property=\"og:url\" content=\"https://canonfodder.wpenginepowered.com/one-of-the-most-remarkable-features-of-early-christian-manuscripts/\" />\n<meta property=\"og:site_name\" content=\"Canon Fodder\" />\n<meta property=\"article:published_time\" content=\"2023-11-27T17:09:49+00:00\" />\n<meta name=\"author\" content=\"Michael Kruger\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:label1\" content=\"Written by\" />\n\t<meta name=\"twitter:data1\" content=\"Michael Kruger\" />\n\t<meta name=\"twitter:label2\" content=\"Est. reading time\" />\n\t<meta name=\"twitter:data2\" content=\"4 minutes\" />\n<script type=\"application/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\/\\/schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/one-of-the-most-remarkable-features-of-early-christian-manuscripts\\/#article\",\"isPartOf\":{\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/one-of-the-most-remarkable-features-of-early-christian-manuscripts\\/\"},\"author\":{\"name\":\"Michael Kruger\",\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\"},\"headline\":\"One of the Most Remarkable Features of Early Christian Manuscripts\",\"datePublished\":\"2023-11-27T17:09:49+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/one-of-the-most-remarkable-features-of-early-christian-manuscripts\\/\"},\"wordCount\":852,\"commentCount\":0,\"publisher\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#\\/schema\\/person\\/b985803864f1d81b09c01a0aa8aa6d22\"},\"image\":{\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/one-of-the-most-remarkable-features-of-early-christian-manuscripts\\/#primaryimage\"},\"thumbnailUrl\":\"https:\\/\\/michaeljkruger.com\\/wp-content\\/uploads\\/2023\\/11\\/p66.bmp\",\"keywords\":[\"Christian Scribes\",\"deity of Jesus\",\"early Christian scribal culture\",\"nomina sacra\",\"Textual Transmission\"],\"articleSection\":[\"Ancient Manuscripts\",\"New Testament Canon\",\"Textual Criticism\"],\"inLanguage\":\"en-US\",\"potentialAction\":[{\"@type\":\"CommentAction\",\"name\":\"Comment\",\"target\":[\"https:\\/\\/canonfodder.wpenginepowered.com\\/one-of-the-most-remarkable-features-of-early-christian-manuscripts\\/#respond\"]}]},{\"@type\":\"WebPage\",\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/one-of-the-most-remarkable-features-of-early-christian-manuscripts\\/\",\"url\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/one-of-the-most-remarkable-features-of-early-christian-manuscripts\\/\",\"name\":\"One of the Most Remarkable Features of Early Christian Manuscripts - Canon Fodder\",\"isPartOf\":{\"@id\":\"https:\\/\\/michaeljkruger.5mt.site\\/#website\"},\"primaryImageOfPage\":{\"@id\":\"https:\\/\\/canonfodder.wpenginepowered.com\\/one-o