    {
      "source": "aomin",
      "sourceId": "35779",
      "title": "A Slightly Abbreviated DL Today: So How DO You Define the Reformation?",
      "author": "Alpha and Omega Ministries (author ID 3)",
      "url": "https://www.aomin.org/aoblog/the-dividing-line/a-slightly-abbreviated-dl-today-so-how-do-you-define-the-reformation/",
      "sha256": "e164f80dcc81957a5648849693aef7c290c45400cb65e63887438c976da8940c",
      "bytes": 2753,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\aomin\\35779.html",
      "acquiredAt": "2026-10-07T20:13:12.052839+00:00",
