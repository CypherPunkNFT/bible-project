    {
      "source": "kruger",
      "sourceId": "6666",
      "title": "Did Jesus Promise to Return within the Lifetime of his Disciples?",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/did-jesus-promise-to-return-within-the-lifetime-of-his-disciples/",
      "sha256": "1d3612a322de131dae15743031c4577050e39e2a31282c4eb66a7f2249bd2ebb",
      "bytes": 1486,
