    {
      "source": "kruger",
      "sourceId": "8748",
      "title": "How I Almost Lost My Faith in College: A Preview of My Latest Book",
      "author": "Michael Kruger",
      "url": "https://michaeljkruger.com/how-i-almost-lost-my-faith-in-college-a-preview-of-my-latest-book/",
      "sha256": "ff94344b09bee87158cfcb544c4078b1faaf5e7a4039c7b77da53d5208274298",
      "bytes": 12157,
      "format": "html",
      "path": "D:\\FortressOfSolitude\\Jarvis\\Projects\\BibleProject\\sources\\library\\bulk\\kruger\\8748.html",
      "acquiredAt": "2026-10-07T20:13:50.499617+00:00",
      "language": "en",
      "audience": "adult readers; pastors; scholars",
      "campaignMission": "RB08",
