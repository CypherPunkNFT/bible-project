ominOrg\"]},{\"@type\":\"Person\",\"@id\":\"https:\\/\\/www.aomin.org\\/aoblog\\/#\\/schema\\/person\\/a476d51c53f2bf91655d03f65623d5d0\",\"name\":\"Mike Porter\",\"image\":{\"@type\":\"ImageObject\",\"inLanguage\":\"en-US\",\"@id\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/6ff1132475874ab6233c1d1f2e8a72be9308a6ea8ab073440287d70b7c7b3acc?s=96&d=mm&r=pg\",\"url\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/6ff1132475874ab6233c1d1f2e8a72be9308a6ea8ab073440287d70b7c7b3acc?s=96&d=mm&r=pg\",\"contentUrl\":\"https:\\/\\/secure.gravatar.com\\/avatar\\/6ff1132475874ab6233c1d1f2e8a72be9308a6ea8ab073440287d70b7c7b3acc?s=96&d=mm&r=pg\",\"caption\":\"Mike Porter\"},\"description\":\"Mike Porter serves as Vice President of Alpha and Omega Ministries. He is a husband and father. He attends Phoenix Reformed Baptist Church in Phoenix, AZ. Mike also occasionally teaches a Greek class out of his home.\",\"sameAs\":[\"http:\\/\\/www.aomin.org\"],\"url\":\"https:\\/\\/www.aomin.org\\/aoblog\\/author\\/gobbler\\/\"}]}</script>\n<!-- / Yoast SEO plugin. -->",
